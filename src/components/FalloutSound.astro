<button
  class="sound-toggle"
  id="fallout-sound-toggle"
  aria-label="Toggle sound effects"
  aria-pressed="false"
>
  <svg class="sound-icon sound-icon--off" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
    <line x1="23" y1="9" x2="17" y2="15"/>
    <line x1="17" y1="9" x2="23" y2="15"/>
  </svg>
  <svg class="sound-icon sound-icon--on" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
  </svg>
</button>

<script>
  class FalloutSoundSystem {
    private ctx: AudioContext | null = null;
    private enabled = false;
    private toggle: HTMLButtonElement;
    private humOsc: OscillatorNode | null = null;
    private humGain: GainNode | null = null;

    constructor() {
      this.toggle = document.getElementById('fallout-sound-toggle') as HTMLButtonElement;
      if (!this.toggle) return;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        this.toggle.style.display = 'none';
        return;
      }

      const saved = sessionStorage.getItem('fallout-sound-enabled');
      if (saved === 'true') {
        this.enabled = true;
        this.toggle.setAttribute('aria-pressed', 'true');
        this.toggle.classList.add('is-active');
      } else {
        this.enabled = false;
        this.toggle.setAttribute('aria-pressed', 'false');
        this.toggle.classList.remove('is-active');
      }

      this.toggle.addEventListener('click', () => this.toggleSound());
      this.setupHoverAndClickSounds();
      this.setupBootSound();
      this.setupUserGestureUnlock();
    }

    private toggleSound() {
      if (!this.ctx) {
        this.ctx = new AudioContext();
      }
      this.enabled = !this.enabled;
      this.toggle.setAttribute('aria-pressed', String(this.enabled));
      this.toggle.classList.toggle('is-active', this.enabled);
      sessionStorage.setItem('fallout-sound-enabled', String(this.enabled));

      if (this.enabled) {
        this.ctx?.resume();
        this.startHum();
        this.playClick();
      } else {
        this.stopHum();
      }
    }

    private startHum() {
      if (!this.ctx || !this.enabled) return;
      try {
        this.stopHum();
        this.humOsc = this.ctx.createOscillator();
        this.humGain = this.ctx.createGain();

        this.humOsc.type = 'sine';
        this.humOsc.frequency.setValueAtTime(60, this.ctx.currentTime); // 60Hz mains hum

        const filter = this.ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(90, this.ctx.currentTime);

        this.humOsc.connect(filter);
        filter.connect(this.humGain);
        this.humGain.connect(this.ctx.destination);

        this.humGain.gain.setValueAtTime(0.003, this.ctx.currentTime);
        this.humOsc.start();
      } catch (e) {
        console.error('Failed to start ambient hum', e);
      }
    }

    private stopHum() {
      if (this.humOsc) {
        try { this.humOsc.stop(); } catch(e){}
        this.humOsc.disconnect();
        this.humOsc = null;
      }
      if (this.humGain) {
        this.humGain.disconnect();
        this.humGain = null;
      }
    }

    private setupHoverAndClickSounds() {
      document.addEventListener('mouseover', (e) => {
        if (!this.enabled || !this.ctx) return;
        const target = e.target as HTMLElement;
        if (target.closest('a, button, .nav-device__btn, .group-block, .project-row')) {
          this.playTick();
        }
      });

      document.addEventListener('click', (e) => {
        if (!this.enabled || !this.ctx) return;
        const target = e.target as HTMLElement;
        if (target.closest('a, button, .nav-device__btn, .group-block, .project-row')) {
          this.playClick();
        }
      });
    }

    private setupBootSound() {
      window.addEventListener('boot-typed', () => {
        if (!this.enabled || !this.ctx) return;
        this.playBootHum();
      });
    }

    private setupUserGestureUnlock() {
      const unlock = () => {
        if (!this.enabled || this.ctx) return;
        this.ctx = new AudioContext();
        this.ctx.resume();
        this.startHum();
      };
      document.addEventListener('pointerdown', unlock, { once: true });
      document.addEventListener('keydown', unlock, { once: true });
    }

    playTick() {
      if (!this.ctx || !this.enabled) return;
      const now = this.ctx.currentTime;
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();

      osc.connect(gain);
      gain.connect(this.ctx.destination);

      osc.type = 'sine';
      osc.frequency.setValueAtTime(2400, now);
      gain.gain.setValueAtTime(0.006, now);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.012);

      osc.start(now);
      osc.stop(now + 0.012);
    }

    playClick() {
      if (!this.ctx || !this.enabled) return;
      const now = this.ctx.currentTime;
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();

      osc.connect(gain);
      gain.connect(this.ctx.destination);

      osc.type = 'square';
      osc.frequency.setValueAtTime(800, now);
      osc.frequency.exponentialRampToValueAtTime(150, now + 0.06);

      gain.gain.setValueAtTime(0.02, now);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.06);

      osc.start(now);
      osc.stop(now + 0.06);
    }

    private playBootHum() {
      if (!this.ctx || !this.enabled) return;
      const now = this.ctx.currentTime;
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();

      osc.connect(gain);
      gain.connect(this.ctx.destination);

      osc.type = 'sine';
      osc.frequency.setValueAtTime(55, now);

      gain.gain.setValueAtTime(0.001, now);
      gain.gain.linearRampToValueAtTime(0.025, now + 0.3);
      gain.gain.linearRampToValueAtTime(0.001, now + 0.8);

      osc.start(now);
      osc.stop(now + 0.8);
    }
  }

  new FalloutSoundSystem();
</script>

<style>
  .sound-toggle {
    position: fixed;
    bottom: 16px;
    right: 16px;
    z-index: 10000;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-panel, rgba(2, 8, 3, 0.92));
    border: 1px solid var(--green-dim, #00cc33);
    border-radius: 4px;
    color: var(--green-dim, #00cc33);
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 200ms ease;
  }

  .sound-toggle:hover {
    opacity: 1;
  }

  .sound-toggle:focus-visible {
    outline: 2px solid var(--amber, #ffb000);
    outline-offset: 2px;
  }

  .sound-toggle.is-active {
    border-color: var(--green, #00ff41);
    color: var(--green, #00ff41);
    opacity: 1;
    box-shadow: 0 0 8px rgba(0, 255, 65, 0.3);
  }

  .sound-icon--on {
    display: none;
  }

  .sound-toggle.is-active .sound-icon--off {
    display: none;
  }

  .sound-toggle.is-active .sound-icon--on {
    display: block;
  }
</style>
