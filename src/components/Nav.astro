<script>
  document.addEventListener('DOMContentLoaded', () => {
    const needle = document.getElementById('geigerNeedle');
    const readout = document.getElementById('doseReadout');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reducedMotion.matches) return;

    let baseAngle = -42;
    let dose = 0.12;
    let lastUpdate = 0;
    const STEP_INTERVAL = 80; // ~12fps — mechanical, not smooth

    // stepped needle animation — feels like a real analog instrument
    const tick = (now: number) => {
      if (now - lastUpdate < STEP_INTERVAL) {
        requestAnimationFrame(tick);
        return;
      }
      lastUpdate = now;

      const jitter = (Math.random() - 0.5) * 22;
      const spike = Math.random() > 0.92 ? (Math.random() * 60 - 30) : 0;
      baseAngle += (Math.random() - 0.5) * 4;
      baseAngle = Math.max(-60, Math.min(60, baseAngle));

      if (needle) {
        needle.style.transform = `rotate(${baseAngle + jitter + spike}deg)`;
      }

      // update digital readout with slight lag
      dose += (Math.random() - 0.48) * 0.03;
      dose = Math.max(0.01, Math.min(3.0, dose));
      if (readout) readout.textContent = dose.toFixed(2);

      requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);

    // random LED flicker — simulates degraded power
    const leds = document.querySelectorAll('.nav-pusher__led, .nav-watch__led');
    const flicker = () => {
      leds.forEach(led => {
        if (Math.random() > 0.93) {
          (led as HTMLElement).style.opacity = '0.3';
          setTimeout(() => {
            (led as HTMLElement).style.opacity = '';
          }, 50 + Math.random() * 100);
        }
      });
      setTimeout(flicker, 200 + Math.random() * 800);
    };
    flicker();
  });
</script>
