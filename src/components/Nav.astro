<script>
  document.addEventListener('DOMContentLoaded', () => {
    const needle = document.getElementById('geigerNeedle');
    if (!needle) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reducedMotion.matches) return;

    let baseAngle = -42;
    let rafId = 0;

    const tick = () => {
      const jitter = (Math.random() - 0.5) * 18;
      const spike = Math.random() > 0.94 ? (Math.random() * 50 - 25) : 0;
      baseAngle += (Math.random() - 0.5) * 3;
      baseAngle = Math.max(-60, Math.min(60, baseAngle));

      const angle = baseAngle + jitter + spike;
      needle.style.transform = `rotate(${angle}deg)`;
      rafId = requestAnimationFrame(tick);
    };

    rafId = requestAnimationFrame(tick);
    reducedMotion.addEventListener?.('change', () => {
      if (reducedMotion.matches) cancelAnimationFrame(rafId);
    });
  });
</script>
