---
---

<canvas id="rad-particles" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('rad-particles') as HTMLCanvasElement;
  if (!canvas) throw new Error('RadParticles canvas not found');

  const ctx = canvas.getContext('2d')!;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = window.matchMedia('(max-width: 767px)').matches;

  // ── Config ──
  const MAX_PARTICLES = prefersReducedMotion ? 18 : isMobile ? 28 : 45;
  const CONNECTION_DIST = isMobile ? 76 : 92;
  const CURSOR_RADIUS = 120;
  const CURSOR_FORCE = 0.4;
  const PARTICLE_SPEED = 0.2;
  const DPR = Math.min(window.devicePixelRatio || 1, isMobile ? 1 : 1.25);
  const FRAME_MS = 1000 / 30;

  const CHARS = '01ABCDEF!@#$%&'.split('');

  // ── State ──
  let width = 0;
  let height = 0;
  let mouseX = -1000;
  let mouseY = -1000;
  let running = true;
  let rafId = 0;
  let lastFrame = 0;

  interface Particle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    char: string;
    size: number;
    opacity: number;
  }

  const particles: Particle[] = [];

  function resize() {
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width * DPR;
    canvas.height = height * DPR;
    canvas.style.width = width + 'px';
    canvas.style.height = height + 'px';
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }

  function createParticle(): Particle {
    return {
      x: Math.random() * width,
      y: Math.random() * height,
      vx: (Math.random() - 0.5) * PARTICLE_SPEED * 2,
      vy: (Math.random() - 0.5) * PARTICLE_SPEED * 2,
      char: CHARS[Math.floor(Math.random() * CHARS.length)],
      size: Math.random() * 4 + 8,
      opacity: Math.random() * 0.3 + 0.1,
    };
  }

  function init() {
    resize();
    particles.length = 0;
    for (let i = 0; i < MAX_PARTICLES; i++) {
      particles.push(createParticle());
    }
    if (prefersReducedMotion) {
      drawFrame();
    } else {
      loop();
    }
  }

  function update() {
    for (const p of particles) {
      // Cursor repulsion
      const dx = p.x - mouseX;
      const dy = p.y - mouseY;
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < CURSOR_RADIUS && dist > 0) {
        const force = (1 - dist / CURSOR_RADIUS) * CURSOR_FORCE;
        p.vx += (dx / dist) * force;
        p.vy += (dy / dist) * force;
      }

      // Damping
      p.vx *= 0.98;
      p.vy *= 0.98;

      // Speed limit
      const speed = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
      if (speed > PARTICLE_SPEED * 4) {
        p.vx = (p.vx / speed) * PARTICLE_SPEED * 4;
        p.vy = (p.vy / speed) * PARTICLE_SPEED * 4;
      }

      p.x += p.vx;
      p.y += p.vy;

      // Wrap around
      if (p.x < -20) p.x = width + 20;
      if (p.x > width + 20) p.x = -20;
      if (p.y < -20) p.y = height + 20;
      if (p.y > height + 20) p.y = -20;

      // Randomly mutate character
      if (Math.random() < 0.005) {
        p.char = CHARS[Math.floor(Math.random() * CHARS.length)];
      }
    }
  }

  function drawFrame() {
    ctx.clearRect(0, 0, width, height);

    // Draw connections
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < CONNECTION_DIST) {
          const alpha = (1 - dist / CONNECTION_DIST) * 0.08;
          ctx.strokeStyle = `rgba(0, 255, 65, ${alpha})`;
          ctx.lineWidth = 0.5;
          ctx.beginPath();
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.stroke();
        }
      }
    }

    // Draw particles as characters
    ctx.font = '12px "VT323", monospace';
    for (const p of particles) {
      ctx.fillStyle = `rgba(0, 255, 65, ${p.opacity})`;
      ctx.font = `${p.size}px "VT323", monospace`;
      ctx.fillText(p.char, p.x, p.y);
    }
  }

  function loop() {
    if (!running) return;
    rafId = requestAnimationFrame(loop);
    const now = performance.now();
    if (now - lastFrame < FRAME_MS) return;
    lastFrame = now;
    update();
    drawFrame();
  }

  // ── Events ──

  window.addEventListener('resize', () => {
    resize();
    if (prefersReducedMotion) drawFrame();
  });

  document.addEventListener('mousemove', (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
  });

  document.addEventListener('mouseleave', () => {
    mouseX = -1000;
    mouseY = -1000;
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      running = false;
      cancelAnimationFrame(rafId);
      rafId = 0;
    } else {
      running = true;
      if (!prefersReducedMotion && rafId === 0) {
        lastFrame = 0;
        rafId = requestAnimationFrame(loop);
      }
    }
  });

  init();
</script>

<style>
  #rad-particles {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }
</style>
