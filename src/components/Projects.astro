---
import SectionHead from './SectionHead.astro';

const projects = [
  { idx: '[01]', name: 'ENV_MONITOR', desc: 'ESP32 多传感器节点 + LoRa 组网 + 云端异常检测', badge: 'HW+ALGO', badgeClass: 'badge-hw', year: '2024' },
  { idx: '[02]', name: 'ASSET_MGR', desc: 'RFID + NFC + Web 后台，设备借还管理', badge: 'FULL', badgeClass: 'badge-full', year: '2024' },
  { idx: '[03]', name: 'GESTURE_IO', desc: 'MediaPipe + 自训练模型，无接触式交互', badge: 'ALGO+APP', badgeClass: 'badge-algo', year: '2023' },
  { idx: '[04]', name: 'WEATHER_STN', desc: '太阳能 + NB-IoT，户外连续工作一整年', badge: 'HW', badgeClass: 'badge-hw', year: '2023' },
];
---

<section class="projects" id="projects">
  <SectionHead marker="SEC.02" label="PROJECTS" />
  {projects.map((p) => (
    <div class="project-row">
      <div class="project-idx">{p.idx}</div>
      <div class="project-body">
        <div class="project-name glow">{p.name}</div>
        <div class="project-desc">{p.desc}</div>
      </div>
      <div class="project-meta">
        <span class={`project-badge ${p.badgeClass}`}>{p.badge}</span>
        <span class="project-year">{p.year}</span>
      </div>
    </div>
  ))}
</section>
