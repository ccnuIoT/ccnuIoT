<div class="screen-fx" aria-hidden="true">
  <span class="screen-fx__noise"></span>
  <span class="screen-fx__bloom"></span>
  <span class="screen-fx__sweep"></span>
  <span class="screen-fx__scanlines"></span>
  <span class="screen-fx__radburst"></span>
  <span class="screen-fx__phosphor"></span>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const effectLayer = document.querySelector('.screen-fx');
    if (!(effectLayer instanceof HTMLElement)) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let nextSweepId = 0;
    let clearSweepId = 0;
    let nextScanId = 0;
    let nextRadId = 0;

    /* --- retinal sweep (existing) --- */
    const scheduleSweep = () => {
      window.clearTimeout(nextSweepId);
      if (reducedMotion.matches) {
        effectLayer.classList.remove('is-sweeping');
        return;
      }
      const delay = 7000 + Math.random() * 13000;
      nextSweepId = window.setTimeout(() => {
        effectLayer.classList.add('is-sweeping');
        clearSweepId = window.setTimeout(() => {
          effectLayer.classList.remove('is-sweeping');
          scheduleSweep();
        }, 1300);
      }, delay);
    };

    /* --- random scanline interference --- */
    const scheduleScanline = () => {
      window.clearTimeout(nextScanId);
      if (reducedMotion.matches) return;

      const delay = 2000 + Math.random() * 6000;
      nextScanId = window.setTimeout(() => {
        const scanlines = effectLayer.querySelector('.screen-fx__scanlines');
        if (scanlines instanceof HTMLElement) {
          const y = Math.random() * 100;
          const thickness = 1 + Math.floor(Math.random() * 3);
          const duration = 80 + Math.floor(Math.random() * 200);
          const glitch = Math.random() > 0.7;

          scanlines.style.cssText = `
            top: ${y}%;
            height: ${thickness}px;
            opacity: ${0.25 + Math.random() * 0.5};
            animation: scanlineFlash ${duration}ms steps(${glitch ? 2 : 1}) forwards;
          `;
          scanlines.classList.add('is-active');

          setTimeout(() => {
            scanlines.classList.remove('is-active');
            scanlines.style.cssText = '';
          }, duration + 50);
        }
        scheduleScanline();
      }, delay);
    };

    /* --- radiation burst --- */
    const scheduleRadBurst = () => {
      window.clearTimeout(nextRadId);
      if (reducedMotion.matches) return;

      const delay = 8000 + Math.random() * 20000;
      nextRadId = window.setTimeout(() => {
        const burst = effectLayer.querySelector('.screen-fx__radburst');
        if (burst instanceof HTMLElement) {
          const x = 10 + Math.random() * 80;
          const y = 10 + Math.random() * 80;
          const size = 60 + Math.random() * 200;
          const intensity = 0.15 + Math.random() * 0.35;

          burst.style.cssText = `
            left: ${x}%;
            top: ${y}%;
            width: ${size}px;
            height: ${size}px;
            opacity: ${intensity};
            animation: radBurst ${600 + Math.random() * 800}ms ease-out forwards;
          `;
          burst.classList.add('is-active');

          setTimeout(() => {
            burst.classList.remove('is-active');
            burst.style.cssText = '';
          }, 1600);
        }
        scheduleRadBurst();
      }, delay);
    };

    /* --- phosphor burn artifact --- */
    const schedulePhosphor = () => {
      if (reducedMotion.matches) return;

      const delay = 12000 + Math.random() * 25000;
      setTimeout(() => {
        const phosphor = effectLayer.querySelector('.screen-fx__phosphor');
        if (phosphor instanceof HTMLElement) {
          const x = 15 + Math.random() * 70;
          const y = 15 + Math.random() * 70;
          const w = 30 + Math.random() * 120;
          const h = 2 + Math.random() * 6;

          phosphor.style.cssText = `
            left: ${x}%;
            top: ${y}%;
            width: ${w}px;
            height: ${h}px;
            opacity: 0;
            animation: phosphorBurn ${3000 + Math.random() * 4000}ms ease-in-out forwards;
          `;
          phosphor.classList.add('is-active');

          setTimeout(() => {
            phosphor.classList.remove('is-active');
            phosphor.style.cssText = '';
          }, 7500);
        }
        schedulePhosphor();
      }, delay);
    };

    const handleMotionChange = () => {
      window.clearTimeout(nextSweepId);
      window.clearTimeout(clearSweepId);
      window.clearTimeout(nextScanId);
      window.clearTimeout(nextRadId);
      effectLayer.classList.remove('is-sweeping');
      scheduleSweep();
      scheduleScanline();
      scheduleRadBurst();
    };

    scheduleSweep();
    scheduleScanline();
    scheduleRadBurst();
    schedulePhosphor();
    reducedMotion.addEventListener?.('change', handleMotionChange);
  });
</script>
