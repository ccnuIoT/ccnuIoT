<div class="term-block">
  <div class="term-block-header">
    <div class="dots"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>
    SYSTEM.LOG
  </div>
  <div class="term-block-body">
    <div class="sys-log" id="sysLog"></div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const el = document.getElementById('sysLog');
    if (!el) return;

    const lines = [
      { text: '[2024-01-15] IoT ASSOC INITIALIZED', color: 'var(--green)' },
      { text: '[2024-01-15] DIVISIONS LOADED: 3 [OK]', color: 'var(--green)' },
      { text: '[2024-01-15] HW_MODULE: ONLINE', color: 'var(--green)' },
      { text: '[2024-01-15] ALGO_MODULE: ONLINE', color: 'var(--green)' },
      { text: '[2024-01-15] APP_MODULE: ONLINE', color: 'var(--green)' },
      { text: '[2024-01-15] NETWORK: CONNECTED', color: 'var(--green)' },
      { text: '[2024-01-15] RAD_MONITOR: 0.12 mSv/h [SAFE]', color: 'var(--green)' },
      { text: '[2024-06-01] RECRUITMENT: ACTIVE', color: 'var(--amber)' },
      { text: '[2024-09-01] PROJECTS_LOADED: 12', color: 'var(--green)' },
    ];

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reducedMotion.matches) {
      el.innerHTML = lines.map(l => `<div style="color:${l.color}">${l.text}</div>`).join('');
      document.dispatchEvent(new CustomEvent('log-typed'));
      return;
    }

    const SPEED = 10;
    const JITTER = 6;
    const LINE_GAP = 120;

    const cursor = document.createElement('span');
    cursor.className = 'type-cursor-char';
    cursor.textContent = '▌';

    function rand(min: number, max: number) {
      return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    function sleep(ms: number) {
      return new Promise<void>(r => setTimeout(r, ms));
    }

    async function typeLine(text: string, color: string) {
      const lineEl = document.createElement('div');
      lineEl.style.color = color;
      lineEl.style.lineHeight = '2';
      lineEl.style.fontSize = '16px';
      el.appendChild(lineEl);
      lineEl.appendChild(cursor);

      for (const ch of text) {
        cursor.before(ch);
        await sleep(rand(SPEED - JITTER, SPEED + JITTER));
      }

      cursor.remove();
      await sleep(LINE_GAP);
    }

    async function run() {
      for (const line of lines) {
        await typeLine(line.text, line.color);
      }
      document.dispatchEvent(new CustomEvent('log-typed'));
    }

    document.addEventListener('hero-typed', () => run(), { once: true });
  });
</script>

<style>
  .sys-log {
    min-height: 200px;
    font-family: 'VT323', monospace;
  }

</style>
