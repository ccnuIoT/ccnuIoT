---
import SectionHead from './SectionHead.astro';
import { divisions } from '../data/site';

const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (href: string) => `${basePath}${href.replace(/^\//, '')}`;
---

<section class="groups" id="divisions" aria-label="Divisions">
  <SectionHead marker="SEC.01" label="DIVISIONS" />
  {divisions.map((g) => (
    <a href={withBase(g.href)} class="group-block group-block--link">
      <div class="group-header">
        <div class="group-idx">{g.idx}</div>
        <div class="group-title-area">
          <div class="group-name glow">{g.name}</div>
          <div class="group-name-en">{g.nameEn}</div>
        </div>
        <div class="group-status">
          <div class="status-indicator">
            <span class="status-dot"></span>ACTIVE
          </div>
        </div>
      </div>
      <div class="group-body">
        <div class="group-desc">{g.desc}</div>
        <div class="group-tags">
          {g.tags.map((t) => <span class="group-tag">{t}</span>)}
        </div>
      </div>
    </a>
  ))}
</section>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.group-block').forEach((card) => {
      card.style.transition = 'transform 400ms cubic-bezier(0.03, 0.98, 0.52, 0.99)';
      card.style.transformStyle = 'preserve-3d';

      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
        const y = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
        card.style.transform = `perspective(800px) rotateY(${x * 4}deg) rotateX(${-y * 4}deg)`;
      });

      card.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(800px) rotateY(0deg) rotateX(0deg)';
      });
    });
  }
</script>
