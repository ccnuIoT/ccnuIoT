---
import Base from '../layouts/Base.astro';
import '../styles/global.css';
import BootSequence from '../components/BootSequence.astro';
import TerminalScene from '../components/TerminalScene.astro';
import RadParticles from '../components/RadParticles.astro';
import ScreenFx from '../components/ScreenFx.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import GeigerBar from '../components/GeigerBar.astro';
import Groups from '../components/Groups.astro';
import Projects from '../components/Projects.astro';
import SystemLog from '../components/SystemLog.astro';
import Join from '../components/Join.astro';
import Footer from '../components/Footer.astro';
import TerminalReveal from '../components/TerminalReveal.astro';
import FalloutSound from '../components/FalloutSound.astro';
---

<Base>
  <BootSequence />
  <TerminalScene />
  <RadParticles />
  <div class="crt-screen">
    <ScreenFx />
    <Nav />
    <div class="container" id="main">
      <Hero />
      <TerminalReveal>
        <GeigerBar />
      </TerminalReveal>
      <TerminalReveal>
        <div class="term-panel">
          <span class="corner corner-tl"></span>
          <span class="corner corner-tr"></span>
          <span class="corner corner-bl"></span>
          <span class="corner corner-br"></span>
          <Groups />
          <span class="term-panel-legend">ROBCO.SEC-01 // DIVISIONS</span>
        </div>
      </TerminalReveal>
      <TerminalReveal>
        <div class="term-panel">
          <span class="corner corner-tl"></span>
          <span class="corner corner-tr"></span>
          <span class="corner corner-bl"></span>
          <span class="corner corner-br"></span>
          <Projects />
          <span class="term-panel-legend">ROBCO.SEC-02 // PROJECTS</span>
        </div>
      </TerminalReveal>
      <TerminalReveal>
        <div class="term-panel">
          <span class="corner corner-tl"></span>
          <span class="corner corner-tr"></span>
          <span class="corner corner-bl"></span>
          <span class="corner corner-br"></span>
          <SystemLog />
          <span class="term-panel-legend">ROBCO.SEC-03 // SYSTEM.LOG</span>
        </div>
      </TerminalReveal>
      <TerminalReveal>
        <div class="term-panel">
          <span class="corner corner-tl"></span>
          <span class="corner corner-tr"></span>
          <span class="corner corner-bl"></span>
          <span class="corner corner-br"></span>
          <Join />
          <span class="term-panel-legend">ROBCO.SEC-04 // RECRUITMENT</span>
        </div>
      </TerminalReveal>
      <Footer />
    </div>
  </div>
  <FalloutSound />
</Base>
