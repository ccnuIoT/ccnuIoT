---
import Base from '../layouts/Base.astro';
import '../styles/global.css';
import BootSequence from '../components/BootSequence.astro';
import TerminalScene from '../components/TerminalScene.astro';
import RadParticles from '../components/RadParticles.astro';
import ScreenFx from '../components/ScreenFx.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import GeigerBar from '../components/GeigerBar.astro';
import Groups from '../components/Groups.astro';
import Projects from '../components/Projects.astro';
import SystemLog from '../components/SystemLog.astro';
import Join from '../components/Join.astro';
import Footer from '../components/Footer.astro';
import TerminalReveal from '../components/TerminalReveal.astro';
import FalloutSound from '../components/FalloutSound.astro';
---

<Base>
  <BootSequence />
  <TerminalScene />
  <RadParticles />
  <div class="crt-screen">
    <ScreenFx />
    <Nav />
    <div class="container" id="main">
      <Hero />
      <TerminalReveal>
        <GeigerBar />
      </TerminalReveal>
      <TerminalReveal>
        <Groups />
      </TerminalReveal>
      <TerminalReveal>
        <Projects />
      </TerminalReveal>
      <TerminalReveal>
        <SystemLog />
      </TerminalReveal>
      <TerminalReveal>
        <Join />
      </TerminalReveal>
      <Footer />
    </div>
  </div>
  <FalloutSound />
</Base>
