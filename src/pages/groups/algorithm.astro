---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import GroupPageNav from '../../components/GroupPageNav.astro';
import CohortSection from '../../components/CohortSection.astro';
import { getGroupCohorts } from '../../data/members';

const cohorts = getGroupCohorts('algorithm');
const chips = ['ML', 'CV', 'DATA', 'INFERENCE'];
---

<Base title="Algorithm Division — CCNU IoT">
  <main class="group-page group-page--algorithm">
    <div class="algo-fx" aria-hidden="true">
      <div class="algo-fx__scanlines"></div>
    </div>
    <GroupPageNav current="algorithm" />

    <section class="algo-hero group-shell">
      <canvas class="algo-hero__canvas" aria-hidden="true"></canvas>
      <div class="algo-hero__copy">
        <p class="algo-hero__eyebrow px">DIVISION 02 / ALGORITHM</p>
        <h1 class="algo-hero__title glow-hard">INDEX / PARSE / PREDICT</h1>
        <p class="algo-hero__desc">
          Streams, models, vectors. The system keeps scanning.
        </p>
      </div>
    </section>

    <section class="group-summary group-shell algo-summary">
      <SectionHead marker="SEC.A2" label="STREAM INDEX" />
      <p class="group-summary__lede">
        Archived by cohort. Roles stay on the card.
      </p>
      <div class="group-summary__chips">
        {chips.map((chip) => <span class="group-summary__chip algo-chip">{chip}</span>)}
      </div>
    </section>

    {cohorts.length === 0 ? (
      <div class="group-empty algo-empty">
        ALGORITHM ROSTER EMPTY. Add cohorts and members to <code>src/data/members.json</code>.
      </div>
    ) : (
      cohorts.map((entry) => (
        <CohortSection cohort={entry.cohort} memberCount={entry.members.length}>
          <div class="algo-card-list">
            {entry.members.map((member) => (
              <article class="algo-card">
                <div class="algo-card__scan" aria-hidden="true"></div>
                <div class="algo-card__avatar-wrap">
                  {member.avatar ? (
                    <img class="member-avatar" src={member.avatar} alt={`${member.name} avatar`} loading="lazy" />
                  ) : (
                    <div class="member-avatar-fallback algo-avatar-fb" aria-hidden="true">
                      {member.name.slice(0, 1)}
                    </div>
                  )}
                </div>
                <div class="algo-card__body">
                  <p class="algo-card__label px">&#9613; SUBJECT</p>
                  <h3>{member.name}</h3>
                  <p class="algo-card__focus">&gt; {member.focus}</p>
                  <p class="algo-card__bio">{member.bio}</p>
                  <div class="member-role-tags">
                    {member.roleTags.map((tag) => (
                      <span class="member-role-tag algo-tag">`{tag}`</span>
                    ))}
                  </div>
                  {member.links && Object.values(member.links).some(Boolean) && (
                    <div class="member-links">
                      {member.links.github && <a href={member.links.github}>GitHub</a>}
                      {member.links.bilibili && <a href={member.links.bilibili}>Bilibili</a>}
                      {member.links.blog && <a href={member.links.blog}>Blog</a>}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </CohortSection>
      ))
    )}
  </main>
</Base>

<style>
  .group-page--algorithm {
    color: #90ff9f;
  }

  /* -- Scanlines overlay -- */
  .algo-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
  }

  .algo-fx__scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      180deg,
      transparent 0,
      transparent 2px,
      rgba(0, 255, 65, 0.03) 2px,
      rgba(0, 255, 65, 0.03) 3px
    );
    mix-blend-mode: screen;
  }

  /* -- Hero -- */
  .algo-hero {
    position: relative;
    overflow: hidden;
    padding: 0;
    min-height: 320px;
    display: flex;
    align-items: flex-end;
    border-color: rgba(0, 255, 65, 0.2);
    background: #000;
  }

  .algo-hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .algo-hero__copy {
    position: relative;
    max-width: 760px;
    padding: 32px;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.4) 60%, transparent 100%);
    width: 100%;
  }

  .algo-hero__eyebrow {
    margin-bottom: 18px;
    font-size: 10px;
    color: rgba(144, 255, 159, 0.7);
  }

  .algo-hero__title {
    font-size: clamp(34px, 7vw, 76px);
    line-height: 1;
    margin-bottom: 18px;
    text-shadow: 0 0 30px rgba(0, 255, 65, 0.4);
  }

  .algo-hero__desc {
    max-width: 620px;
    font-size: 24px;
    line-height: 1.4;
    color: rgba(144, 255, 159, 0.85);
  }

  /* -- Summary -- */
  .algo-summary {
    border-color: rgba(0, 255, 65, 0.18);
    background: rgba(0, 5, 0, 0.85);
  }

  .algo-chip {
    border-color: rgba(0, 255, 65, 0.25);
    color: #90ff9f;
  }

  /* -- Card list -- */
  .algo-card-list {
    display: grid;
    gap: 16px;
  }

  .algo-card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 20px;
    padding: 20px;
    border: 1px dashed rgba(0, 255, 65, 0.3);
    background: rgba(0, 10, 1, 0.92);
    transition: border-color 200ms ease;
  }

  /* -- Scan-line hover effect -- */
  .algo-card__scan {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent, rgba(0, 255, 65, 0.08), transparent);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .algo-card:hover .algo-card__scan {
      opacity: 1;
      animation: algo-scan 800ms linear;
    }

    .algo-card:hover {
      border-color: rgba(0, 255, 65, 0.6);
    }
  }

  @keyframes algo-scan {
    from { transform: translateY(-100%); }
    to { transform: translateY(100%); }
  }

  /* -- Avatar -- */
  .algo-card__avatar-wrap {
    flex: 0 0 auto;
  }

  .algo-avatar-fb {
    background: linear-gradient(180deg, rgba(0, 255, 65, 0.16), rgba(35, 121, 255, 0.12));
    color: #91ffac;
    border: 1px solid rgba(0, 255, 65, 0.24);
    width: 82px;
    height: 82px;
  }

  .algo-card__body {
    min-width: 0;
  }

  .algo-card__label {
    font-size: 10px;
    margin-bottom: 10px;
    color: rgba(144, 255, 159, 0.6);
    animation: algo-cursor 1s steps(2) infinite;
  }

  @keyframes algo-cursor {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .algo-card__label {
      animation: none;
    }
  }

  .algo-card h3 {
    font-size: 28px;
    line-height: 1;
    margin-bottom: 8px;
    text-shadow: 0 0 12px rgba(0, 255, 65, 0.25);
  }

  .algo-card__focus {
    color: #7ef7ff;
    margin-bottom: 10px;
    font-family: 'VT323', monospace;
    font-size: 18px;
  }

  .algo-card__bio {
    line-height: 1.5;
    color: rgba(144, 255, 159, 0.85);
  }

  /* -- Tags as inline code -- */
  .algo-tag {
    border-color: rgba(0, 255, 65, 0.3);
    background: rgba(0, 255, 65, 0.06);
    font-family: 'VT323', monospace;
    font-size: 16px;
    padding: 3px 10px;
    color: #90ff9f;
  }

  /* -- Empty state -- */
  .algo-empty {
    border-color: rgba(0, 255, 65, 0.3);
    background: rgba(0, 5, 0, 0.6);
  }

  /* -- Responsive -- */
  @media (max-width: 720px) {
    .algo-hero {
      min-height: 240px;
    }

    .algo-hero__copy {
      padding: 20px;
    }

    .algo-card {
      grid-template-columns: 1fr;
      padding: 16px;
    }

    .algo-hero__desc {
      font-size: 20px;
    }
  }
</style>

<script>
  (() => {
    const canvas = document.querySelector('.algo-hero__canvas');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789ABCDEF(){}[]<>fn=>vec::';
    const charArr = Array.from(chars);

    const fontSize = 16;
    let columns = [];
    let w = 0;
    let h = 0;

    function resize() {
      const rect = canvas.parentElement.getBoundingClientRect();
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = rect.width;
      h = rect.height;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      initColumns();
    }

    function initColumns() {
      const colCount = Math.floor(w / fontSize);
      columns = [];
      for (let i = 0; i < colCount; i++) {
        columns.push({
          x: i * fontSize,
          y: Math.random() * h,
          speed: 0.5 + Math.random() * 1.5,
          chars: [],
          len: 12 + Math.floor(Math.random() * 18),
        });
        for (let j = 0; j < columns[i].len; j++) {
          columns[i].chars.push(charArr[Math.floor(Math.random() * charArr.length)]);
        }
      }
    }

    function drawFrame() {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.06)';
      ctx.fillRect(0, 0, w, h);

      for (const col of columns) {
        for (let j = 0; j < col.len; j++) {
          const yPos = col.y - j * fontSize;
          if (yPos < 0 || yPos > h) continue;

          const alpha = 1 - j / col.len;
          if (j === 0) {
            ctx.fillStyle = `rgba(200, 255, 200, ${alpha})`;
            ctx.shadowColor = '#00ff41';
            ctx.shadowBlur = 8;
          } else {
            ctx.fillStyle = `rgba(0, 255, 65, ${alpha * 0.7})`;
            ctx.shadowBlur = 0;
          }

          ctx.font = `${fontSize}px monospace`;
          ctx.fillText(col.chars[j], col.x, yPos);
        }
        ctx.shadowBlur = 0;

        col.y += col.speed * fontSize * 0.4;

        if (Math.random() < 0.04) {
          const idx = Math.floor(Math.random() * col.chars.length);
          col.chars[idx] = charArr[Math.floor(Math.random() * charArr.length)];
        }

        if (col.y - col.len * fontSize > h) {
          col.y = 0;
          col.speed = 0.5 + Math.random() * 1.5;
        }
      }

      if (!reduceMotion) {
        requestAnimationFrame(drawFrame);
      }
    }

    resize();
    if (reduceMotion) {
      for (let i = 0; i < 80; i++) drawFrame();
    } else {
      requestAnimationFrame(drawFrame);
    }

    let resizeTimer;
    const ro = new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(resize, 200);
    });
    ro.observe(canvas.parentElement);
  })();
</script>
