---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import GroupPageNav from '../../components/GroupPageNav.astro';
import CohortSection from '../../components/CohortSection.astro';
import { getGroupCohorts } from '../../data/members';

const cohorts = getGroupCohorts('algorithm');
const chips = ['ML', 'CV', 'DATA', 'INFERENCE'];
---

<Base title="Algorithm Division — CCNU IoT">
  <main class="group-page group-page--algorithm">
    <GroupPageNav current="algorithm" />

    <section class="algorithm-hero group-shell">
      <div class="algorithm-rain" aria-hidden="true">
        <span>010101</span><span>tensor</span><span>matrix</span><span>signal</span><span>vision</span><span>trace</span>
      </div>
      <div class="algorithm-hero__copy">
        <p class="algorithm-hero__eyebrow px">DIVISION 02 / ALGORITHM</p>
        <h1 class="algorithm-hero__title glow-hard">INDEX / PARSE / PREDICT</h1>
        <p class="algorithm-hero__desc">
          算法组像一套持续扫描的系统：输入、推断、识别、校正。每位成员的轨迹都像被索引进同一份数据流。
        </p>
      </div>
    </section>

    <section class="group-summary group-shell">
      <SectionHead marker="SEC.A2" label="STREAM INDEX" />
      <p class="group-summary__lede">
        按届检索算法组成员，每张卡片展示方向、简介和组内 / 协会职务标签。
      </p>
      <div class="group-summary__chips">
        {chips.map((chip) => <span class="group-summary__chip">{chip}</span>)}
      </div>
    </section>

    {cohorts.length === 0 ? (
      <div class="group-empty">
        ALGORITHM ROSTER EMPTY. Add cohorts and members to <code>src/data/members.json</code>.
      </div>
    ) : (
      cohorts.map((entry) => (
        <CohortSection cohort={entry.cohort} memberCount={entry.members.length}>
          <div class="algorithm-card-list">
            {entry.members.map((member) => (
              <article class="algorithm-card">
                <div class="algorithm-card__scan" aria-hidden="true"></div>
                <div class="algorithm-card__avatar-wrap">
                  {member.avatar ? (
                    <img class="member-avatar" src={member.avatar} alt={`${member.name} avatar`} loading="lazy" />
                  ) : (
                    <div class="member-avatar-fallback algorithm-avatar-fallback" aria-hidden="true">
                      {member.name.slice(0, 1)}
                    </div>
                  )}
                </div>
                <div class="algorithm-card__body">
                  <p class="algorithm-card__label px">SUBJECT</p>
                  <h3>{member.name}</h3>
                  <p class="algorithm-card__focus">{member.focus}</p>
                  <p class="algorithm-card__bio">{member.bio}</p>
                  <div class="member-role-tags">
                    {member.roleTags.map((tag) => <span class="member-role-tag">{tag}</span>)}
                  </div>
                  {member.links && Object.values(member.links).some(Boolean) && (
                    <div class="member-links">
                      {member.links.github && <a href={member.links.github}>GitHub</a>}
                      {member.links.bilibili && <a href={member.links.bilibili}>Bilibili</a>}
                      {member.links.blog && <a href={member.links.blog}>Blog</a>}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </CohortSection>
      ))
    )}
  </main>
</Base>

<style>
  .group-page--algorithm {
    color: #90ff9f;
  }

  .algorithm-hero {
    position: relative;
    overflow: hidden;
    padding: 30px;
    background:
      radial-gradient(circle at top center, rgba(0, 255, 65, 0.08), transparent 32%),
      linear-gradient(180deg, rgba(0, 5, 0, 0.98), rgba(0, 12, 3, 0.96));
  }

  .algorithm-rain {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: space-around;
    gap: 16px;
    overflow: hidden;
    opacity: 0.18;
    pointer-events: none;
  }

  .algorithm-rain span {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-family: 'Press Start 2P', monospace;
    font-size: 10px;
    color: #74ff8f;
  }

  .algorithm-hero__copy {
    position: relative;
    max-width: 760px;
  }

  .algorithm-hero__eyebrow {
    margin-bottom: 18px;
    font-size: 10px;
  }

  .algorithm-hero__title {
    font-size: clamp(34px, 7vw, 76px);
    line-height: 1;
    margin-bottom: 18px;
  }

  .algorithm-hero__desc {
    max-width: 620px;
    font-size: 24px;
    line-height: 1.4;
  }

  .algorithm-card-list {
    display: grid;
    gap: 14px;
  }

  .algorithm-card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 18px;
    padding: 18px;
    border: 1px solid rgba(0, 255, 65, 0.2);
    background: rgba(0, 10, 1, 0.92);
  }

  .algorithm-card__scan {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent, rgba(0, 255, 65, 0.06), transparent);
    opacity: 0;
    pointer-events: none;
  }

  .algorithm-avatar-fallback {
    background: linear-gradient(180deg, rgba(0, 255, 65, 0.16), rgba(35, 121, 255, 0.12));
    color: #91ffac;
    border: 1px solid rgba(0, 255, 65, 0.24);
  }

  .algorithm-card__label {
    font-size: 10px;
    margin-bottom: 10px;
    color: rgba(144, 255, 159, 0.8);
  }

  .algorithm-card h3 {
    font-size: 30px;
    line-height: 1;
    margin-bottom: 8px;
  }

  .algorithm-card__focus {
    color: #7ef7ff;
    margin-bottom: 10px;
  }

  .algorithm-card__bio {
    line-height: 1.45;
  }

  @media (prefers-reduced-motion: no-preference) {
    .algorithm-rain span {
      animation: algorithm-fall 8s linear infinite;
    }

    .algorithm-rain span:nth-child(2n) {
      animation-duration: 10s;
    }

    .algorithm-card:hover .algorithm-card__scan {
      opacity: 1;
      animation: algorithm-scan 900ms linear;
    }
  }

  @keyframes algorithm-fall {
    from { transform: translateY(-18px); }
    to { transform: translateY(18px); }
  }

  @keyframes algorithm-scan {
    from { transform: translateY(-100%); }
    to { transform: translateY(100%); }
  }

  @media (max-width: 720px) {
    .algorithm-hero,
    .algorithm-card {
      padding: 18px;
    }

    .algorithm-card {
      grid-template-columns: 1fr;
    }

    .algorithm-hero__desc {
      font-size: 20px;
    }
  }
</style>
