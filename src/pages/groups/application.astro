---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import GroupPageNav from '../../components/GroupPageNav.astro';
import CohortSection from '../../components/CohortSection.astro';
import { getGroupCohorts } from '../../data/members';

const cohorts = getGroupCohorts('application');
const chips = ['UI', 'MOBILE', 'WEB', 'BACKEND'];
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const assetPath = (path: string) => path.startsWith('/') ? `${basePath}${path.replace(/^\//, '')}` : path;
---

<Base title="Application Division - CCNU IoT">
  <main class="group-page group-page--application">
    <div class="app-fx" aria-hidden="true">
      <span class="app-fx__cloud app-fx__cloud--a"></span>
      <span class="app-fx__cloud app-fx__cloud--b"></span>
      <span class="app-fx__cloud app-fx__cloud--c"></span>
      <span class="app-fx__hill app-fx__hill--a"></span>
      <span class="app-fx__hill app-fx__hill--b"></span>
      <span class="app-fx__block app-fx__block--a">?</span>
      <span class="app-fx__block app-fx__block--b"></span>
      <span class="app-fx__pipe app-fx__pipe--a"></span>
    </div>
    <GroupPageNav current="application" />

    <section class="app-stage" aria-labelledby="app-world-title">
      <div class="app-stage__hud px" aria-hidden="true">
        <span>APP</span>
        <span>WORLD 3-1</span>
        <span>TEAM x {cohorts.reduce((count, entry) => count + entry.members.length, 0)}</span>
      </div>
      <div class="app-stage__scene">
        <div class="app-stage__copy">
          <p class="app-stage__eyebrow px">DIVISION 03 / APPLICATION</p>
          <h1 id="app-world-title" class="app-stage__title px">APP WORLD 3-1</h1>
          <p class="app-stage__prompt px">PRESS START TO SHIP</p>
          <p class="app-stage__desc">
            UI, mobile, web, and backend services move through the same course: build the screen, wire the flow, ship the feature.
          </p>
        </div>
        <div class="app-course" aria-hidden="true">
          <span class="app-course__cloud app-course__cloud--a"></span>
          <span class="app-course__cloud app-course__cloud--b"></span>
          <span class="app-course__pipe"></span>
          <span class="app-course__flag"></span>
          <span class="app-course__block app-course__block--q">?</span>
          <span class="app-course__block app-course__block--brick"></span>
          <span class="app-course__step app-course__step--a"></span>
          <span class="app-course__step app-course__step--b"></span>
          <span class="app-course__ground"></span>
        </div>
      </div>
    </section>

    <section class="group-summary group-shell app-summary">
      <SectionHead marker="WORLD" label="STAGE SELECT" />
      <p class="group-summary__lede">
        Pick a cohort stage. Power-ups map to the App team's core shipping lanes.
      </p>
      <div class="group-summary__chips">
        {chips.map((chip) => <span class="group-summary__chip app-chip">{chip}</span>)}
      </div>
    </section>

    {cohorts.length === 0 ? (
      <div class="group-empty app-empty">
        APPLICATION ROSTER EMPTY. Add cohorts and members to <code>src/data/members.json</code>.
      </div>
    ) : (
      cohorts.map((entry) => (
        <CohortSection cohort={entry.cohort} memberCount={entry.members.length}>
          <div class="app-grid">
            {entry.members.map((member, i) => {
              const ui = 62 + ((i * 19) % 34);
              const web = 58 + ((i * 23) % 38);
              const api = 54 + ((i * 29) % 40);
              const classLabel = member.focus || 'APP DEV';
              return (
                <article class="app-card">
                  <div class="app-card__slot px">P{String(i + 1).padStart(2, '0')}</div>
                  <div class="app-card__top">
                    <div class="app-card__portrait">
                      {member.avatar ? (
                        <img class="member-avatar" src={assetPath(member.avatar)} alt={`${member.name} avatar`} loading="lazy" />
                      ) : (
                        <div class="member-avatar-fallback app-avatar-fb" aria-hidden="true">
                          {member.name.slice(0, 1)}
                        </div>
                      )}
                    </div>
                    <div class="app-card__info">
                      <h3>{member.name}</h3>
                      <p class="app-card__class px">{classLabel}</p>
                    </div>
                  </div>
                  <p class="app-card__bio">{member.bio}</p>
                  <div class="app-card__stats" aria-hidden="true">
                    <div class="app-stat">
                      <span class="app-stat__label">UI</span>
                      <div class="app-stat__bar">
                        <div class="app-stat__fill app-stat__fill--ui" style={`width: ${ui}%`}></div>
                      </div>
                    </div>
                    <div class="app-stat">
                      <span class="app-stat__label">WEB</span>
                      <div class="app-stat__bar">
                        <div class="app-stat__fill app-stat__fill--web" style={`width: ${web}%`}></div>
                      </div>
                    </div>
                    <div class="app-stat">
                      <span class="app-stat__label">API</span>
                      <div class="app-stat__bar">
                        <div class="app-stat__fill app-stat__fill--api" style={`width: ${api}%`}></div>
                      </div>
                    </div>
                  </div>
                  <div class="member-role-tags">
                    {member.roleTags.map((tag) => <span class="member-role-tag app-tag">{tag}</span>)}
                  </div>
                  {member.links && Object.values(member.links).some(Boolean) && (
                    <div class="member-links">
                      {member.links.github && <a href={member.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>}
                      {member.links.bilibili && <a href={member.links.bilibili} target="_blank" rel="noopener noreferrer">Bilibili</a>}
                      {member.links.blog && <a href={member.links.blog} target="_blank" rel="noopener noreferrer">Blog</a>}
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </CohortSection>
      ))
    )}
  </main>
</Base>

<style>
  .group-page--application {
    --app-sky: #7ec8ff;
    --app-sky-light: #bde8ff;
    --app-cloud: #f6fbff;
    --app-grass: #4caf50;
    --app-grass-dark: #2f7d32;
    --app-brick: #b7652f;
    --app-brick-dark: #7a3f1d;
    --app-soil: #5d341f;
    --app-hud: #17202a;
    --app-panel: #fff4cc;
    --app-coin: #f8c537;
    color: var(--app-hud);
    padding-top: 76px;
  }

  .group-page--application::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -3;
    background:
      linear-gradient(rgba(255, 255, 255, 0.24) 2px, transparent 2px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.18) 2px, transparent 2px),
      linear-gradient(180deg, #7ec8ff 0%, #bde8ff 62%, #8bd06a 62%, #4caf50 72%, #5d341f 72%, #3f2215 100%);
    background-size: 28px 28px, 28px 28px, auto;
  }

  .group-page--application :global(.group-page-nav__home),
  .group-page--application :global(.group-page-nav__link) {
    color: var(--app-hud);
    border: 3px solid var(--app-hud);
    background: var(--app-cloud);
    box-shadow: 4px 4px 0 rgba(23, 32, 42, 0.26);
  }

  .group-page--application :global(.group-page-nav__home:hover),
  .group-page--application :global(.group-page-nav__link:hover),
  .group-page--application :global(.group-page-nav__link.is-current) {
    background: var(--app-coin);
    border-color: var(--app-hud);
  }

  .app-fx {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .app-fx__cloud,
  .app-course__cloud {
    position: absolute;
    width: 78px;
    height: 30px;
    background: var(--app-cloud);
    box-shadow: 18px -14px 0 var(--app-cloud), 42px -8px 0 var(--app-cloud), 66px 0 0 var(--app-cloud);
  }

  .app-fx__cloud--a { top: 150px; left: 8%; opacity: 0.86; }
  .app-fx__cloud--b { top: 330px; right: 15%; opacity: 0.7; transform: scale(0.8); }
  .app-fx__cloud--c { top: 920px; left: 16%; opacity: 0.58; transform: scale(0.7); }

  .app-fx__hill {
    position: absolute;
    bottom: 8%;
    width: 180px;
    height: 90px;
    border: 4px solid rgba(23, 32, 42, 0.24);
    border-bottom: 0;
    border-radius: 120px 120px 0 0;
    background: rgba(76, 175, 80, 0.5);
  }

  .app-fx__hill--a { left: -30px; }
  .app-fx__hill--b { right: 8%; transform: scale(0.76); opacity: 0.72; }

  .app-fx__block {
    position: absolute;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 3px solid var(--app-hud);
    background: var(--app-coin);
    box-shadow: inset -4px -4px 0 rgba(122, 63, 29, 0.22), 4px 4px 0 rgba(23, 32, 42, 0.22);
    font-family: 'Press Start 2P', monospace;
    font-size: 14px;
  }

  .app-fx__block--a { top: 250px; right: 24%; }
  .app-fx__block--b { top: 760px; right: 10%; background: var(--app-brick); }

  .app-fx__pipe,
  .app-course__pipe {
    position: absolute;
    background: linear-gradient(90deg, var(--app-grass-dark), var(--app-grass), var(--app-grass-dark));
    border: 4px solid var(--app-hud);
    box-shadow: inset 8px 0 0 rgba(255, 255, 255, 0.16);
  }

  .app-fx__pipe--a {
    bottom: 6%;
    right: 6%;
    width: 60px;
    height: 90px;
  }

  .app-stage {
    position: relative;
    max-width: 1020px;
    margin: 0 auto;
  }

  .app-stage__hud {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 10px;
    padding: 10px 12px;
    border: 3px solid var(--app-hud);
    background: rgba(246, 251, 255, 0.86);
    box-shadow: 4px 4px 0 rgba(23, 32, 42, 0.22);
    color: var(--app-hud);
    font-size: 8px;
    line-height: 1.6;
  }

  .app-stage__scene {
    position: relative;
    min-height: 390px;
    overflow: hidden;
    border: 4px solid var(--app-hud);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.22), transparent 48%),
      linear-gradient(180deg, var(--app-sky) 0%, var(--app-sky-light) 64%, var(--app-grass) 64%, var(--app-grass) 74%, var(--app-soil) 74%);
    box-shadow: 8px 8px 0 rgba(23, 32, 42, 0.26);
  }

  .app-stage__copy {
    position: relative;
    z-index: 2;
    max-width: 570px;
    padding: clamp(22px, 4vw, 42px);
  }

  .app-stage__eyebrow {
    margin-bottom: 14px;
    color: #17466b;
    font-size: 9px;
  }

  .app-stage__title {
    max-width: 560px;
    margin-bottom: 16px;
    color: var(--app-panel);
    font-size: clamp(26px, 5vw, 56px);
    line-height: 1.22;
    text-shadow: 4px 4px 0 var(--app-hud), 8px 8px 0 var(--app-brick-dark);
  }

  .app-stage__prompt {
    margin-bottom: 18px;
    color: var(--app-hud);
    font-size: 10px;
  }

  .app-stage__desc {
    max-width: 520px;
    padding: 14px 16px;
    border: 3px solid var(--app-hud);
    background: rgba(246, 251, 255, 0.86);
    color: var(--app-hud);
    font-size: 20px;
    line-height: 1.42;
    box-shadow: 4px 4px 0 rgba(23, 32, 42, 0.2);
  }

  .app-course {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .app-course__cloud--a { top: 62px; right: 120px; }
  .app-course__cloud--b { top: 142px; right: 290px; transform: scale(0.7); opacity: 0.84; }

  .app-course__pipe {
    right: 66px;
    bottom: 74px;
    width: 74px;
    height: 110px;
  }

  .app-course__pipe::before {
    content: '';
    position: absolute;
    left: -12px;
    right: -12px;
    top: -28px;
    height: 28px;
    border: 4px solid var(--app-hud);
    background: linear-gradient(90deg, var(--app-grass-dark), var(--app-grass), var(--app-grass-dark));
  }

  .app-course__flag {
    position: absolute;
    right: 190px;
    bottom: 74px;
    width: 8px;
    height: 170px;
    background: var(--app-hud);
  }

  .app-course__flag::after {
    content: '';
    position: absolute;
    left: 8px;
    top: 10px;
    width: 74px;
    height: 38px;
    background: var(--app-panel);
    border: 3px solid var(--app-hud);
    box-shadow: inset -8px 0 0 var(--app-coin);
  }

  .app-course__block,
  .app-course__step {
    position: absolute;
    display: grid;
    place-items: center;
    border: 4px solid var(--app-hud);
    box-shadow: inset -5px -5px 0 rgba(93, 52, 31, 0.22);
  }

  .app-course__block {
    width: 44px;
    height: 44px;
    font-family: 'Press Start 2P', monospace;
    font-size: 16px;
  }

  .app-course__block--q { right: 320px; top: 120px; background: var(--app-coin); }
  .app-course__block--brick { right: 264px; top: 120px; background: var(--app-brick); }
  .app-course__step { background: var(--app-brick); }
  .app-course__step--a { right: 405px; bottom: 74px; width: 54px; height: 44px; }
  .app-course__step--b { right: 459px; bottom: 74px; width: 54px; height: 88px; }

  .app-course__ground {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 74px;
    background:
      linear-gradient(90deg, rgba(255,255,255,0.14) 2px, transparent 2px),
      linear-gradient(rgba(255,255,255,0.12) 2px, transparent 2px),
      var(--app-soil);
    background-size: 36px 36px;
    border-top: 4px solid var(--app-hud);
  }

  .app-summary {
    margin-top: 34px;
    border: 4px solid var(--app-hud);
    border-radius: 0;
    background: rgba(246, 251, 255, 0.9);
    color: var(--app-hud);
    box-shadow: 6px 6px 0 rgba(23, 32, 42, 0.22);
  }

  .app-summary :global(.section-head) { color: var(--app-hud); }
  .app-summary :global(.section-head .marker) { background: var(--app-hud); color: var(--app-panel); border-color: var(--app-hud); }
  .app-summary :global(.section-head .line) { background: var(--app-hud); }

  .app-summary .group-summary__lede {
    color: var(--app-hud);
  }

  .app-chip {
    border: 3px solid var(--app-hud);
    color: var(--app-hud);
    background: var(--app-panel);
    box-shadow: 3px 3px 0 rgba(23, 32, 42, 0.2);
  }

  .group-page--application :global(.cohort-section) {
    border: 4px solid var(--app-hud);
    border-radius: 0;
    background: rgba(246, 251, 255, 0.88);
    box-shadow: 6px 6px 0 rgba(23, 32, 42, 0.2);
  }

  .group-page--application :global(.cohort-section__header) {
    border-bottom: 4px solid var(--app-hud);
    color: var(--app-hud);
    background: var(--app-panel);
  }

  .group-page--application :global(.cohort-section__count) {
    color: var(--app-hud);
  }

  .app-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(286px, 1fr));
    gap: 20px;
  }

  .app-card {
    position: relative;
    min-width: 0;
    padding: 18px;
    border: 4px solid var(--app-hud);
    border-radius: 0;
    color: var(--app-hud);
    background:
      linear-gradient(180deg, var(--app-panel) 0 42px, rgba(246, 251, 255, 0.96) 42px 100%);
    box-shadow: 6px 6px 0 rgba(23, 32, 42, 0.26);
    transition: transform 160ms steps(2), box-shadow 160ms steps(2);
  }

  .app-card__slot {
    display: inline-block;
    margin-bottom: 14px;
    padding: 5px 8px;
    border: 3px solid var(--app-hud);
    background: var(--app-coin);
    font-size: 8px;
  }

  .app-card__top {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
    min-width: 0;
  }

  .app-card__portrait {
    flex: 0 0 auto;
    padding: 4px;
    border: 4px solid var(--app-hud);
    border-radius: 0;
    background: var(--app-sky-light);
    box-shadow: inset -5px -5px 0 rgba(23, 32, 42, 0.12);
  }

  .app-card__portrait .member-avatar,
  .app-card__portrait .member-avatar-fallback {
    width: 66px;
    height: 66px;
    border: 0;
    border-radius: 0;
  }

  .app-avatar-fb {
    background: var(--app-cloud);
    color: var(--app-hud);
    font-size: 20px;
  }

  .app-card__info {
    min-width: 0;
  }

  .app-card__info h3 {
    color: var(--app-hud);
    font-family: 'Press Start 2P', monospace;
    font-size: 13px;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .app-card__class {
    margin-top: 7px;
    color: var(--app-brick-dark);
    font-size: 8px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .app-card__bio {
    margin-bottom: 14px;
    color: #243447;
    font-size: 18px;
    line-height: 1.45;
  }

  .app-card__stats {
    display: grid;
    gap: 8px;
    margin-bottom: 14px;
  }

  .app-stat {
    display: grid;
    grid-template-columns: 34px 1fr;
    align-items: center;
    gap: 8px;
  }

  .app-stat__label {
    color: var(--app-hud);
    font-family: 'Press Start 2P', monospace;
    font-size: 8px;
  }

  .app-stat__bar {
    height: 14px;
    border: 3px solid var(--app-hud);
    background: var(--app-cloud);
    overflow: hidden;
  }

  .app-stat__fill {
    height: 100%;
    box-shadow: inset 0 -3px 0 rgba(23, 32, 42, 0.16);
  }

  .app-stat__fill--ui { background: var(--app-coin); }
  .app-stat__fill--web { background: var(--app-sky); }
  .app-stat__fill--api { background: var(--app-grass); }

  .app-tag {
    border: 3px solid var(--app-hud);
    border-radius: 0;
    color: var(--app-hud);
    background: var(--app-cloud);
    box-shadow: 3px 3px 0 rgba(23, 32, 42, 0.18);
  }

  .group-page--application :global(.member-links a) {
    display: inline-block;
    padding: 5px 8px;
    border: 3px solid var(--app-hud);
    color: var(--app-hud);
    background: var(--app-panel);
    font-family: 'Press Start 2P', monospace;
    font-size: 8px;
    line-height: 1.4;
    box-shadow: 3px 3px 0 rgba(23, 32, 42, 0.18);
  }

  .app-empty {
    border: 4px dashed var(--app-hud);
    color: var(--app-hud);
    background: rgba(246, 251, 255, 0.9);
  }

  @media (prefers-reduced-motion: no-preference) {
    .app-fx__cloud--a,
    .app-course__cloud--a {
      animation: app-cloud-drift 18s linear infinite alternate;
    }

    .app-stage__prompt {
      animation: app-start-blink 1.1s steps(2) infinite;
    }

    .app-course__flag::after {
      animation: app-flag 1.6s steps(2) infinite;
    }

    .app-card:hover {
      transform: translate(-2px, -4px);
      box-shadow: 8px 10px 0 rgba(23, 32, 42, 0.26);
    }
  }

  @keyframes app-cloud-drift {
    from { transform: translateX(0); }
    to { transform: translateX(28px); }
  }

  @keyframes app-start-blink {
    50% { opacity: 0.35; }
  }

  @keyframes app-flag {
    50% { transform: translateY(2px); }
  }

  @media (max-width: 820px) {
    .app-stage__scene {
      min-height: 520px;
    }

    .app-course__block--q,
    .app-course__block--brick,
    .app-course__step--a,
    .app-course__step--b {
      display: none;
    }

    .app-course__pipe {
      right: 28px;
    }

    .app-course__flag {
      right: 132px;
    }
  }

  @media (max-width: 720px) {
    .group-page--application {
      padding-top: 64px;
    }

    .app-stage__hud {
      display: grid;
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .app-stage__copy {
      padding: 18px;
    }

    .app-stage__title {
      font-size: 26px;
    }

    .app-stage__desc {
      font-size: 18px;
    }

    .app-grid {
      grid-template-columns: 1fr;
    }

    .app-card__top {
      align-items: flex-start;
    }

    .app-card__portrait .member-avatar,
    .app-card__portrait .member-avatar-fallback {
      width: 58px;
      height: 58px;
    }

    .app-card__info h3 {
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-fx__cloud--a,
    .app-course__cloud--a,
    .app-stage__prompt,
    .app-course__flag::after,
    .app-card {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
