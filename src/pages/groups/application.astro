---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import GroupPageNav from '../../components/GroupPageNav.astro';
import CohortSection from '../../components/CohortSection.astro';
import { getGroupCohorts } from '../../data/members';

const cohorts = getGroupCohorts('application');
const chips = ['UI', 'MOBILE', 'WEB', 'BACKEND'];
---

<Base title="Application Division — CCNU IoT">
  <main class="group-page group-page--application">
    <div class="app-fx" aria-hidden="true">
      <div class="app-fx__grid"></div>
      <span class="app-fx__star app-fx__star--a"></span>
      <span class="app-fx__star app-fx__star--b"></span>
      <span class="app-fx__star app-fx__star--c"></span>
      <span class="app-fx__star app-fx__star--d"></span>
      <span class="app-fx__star app-fx__star--e"></span>
    </div>
    <GroupPageNav current="application" />

    <section class="app-hero group-shell">
      <div class="app-hero__frame">
        <span class="app-hero__corner app-hero__corner--tl" aria-hidden="true"></span>
        <span class="app-hero__corner app-hero__corner--tr" aria-hidden="true"></span>
        <span class="app-hero__corner app-hero__corner--bl" aria-hidden="true"></span>
        <span class="app-hero__corner app-hero__corner--br" aria-hidden="true"></span>
        <p class="app-hero__eyebrow px">DIVISION 03 / APPLICATION</p>
        <h1 class="app-hero__title px">SELECT YOUR PARTY</h1>
        <p class="app-hero__prompt px">▶ PRESS START_</p>
        <p class="app-hero__desc">
          UI, mobile, web, services. Built to ship.
        </p>
        <div class="app-hero__gradient-line" aria-hidden="true"></div>
      </div>
    </section>

    <div class="app-star-divider" aria-hidden="true">
      <span class="app-star-divider__line"></span>
      <span class="app-star-divider__star">✦</span>
      <span class="app-star-divider__line"></span>
    </div>

    <section class="group-summary group-shell app-summary">
      <SectionHead marker="SEC.P3" label="PLAYER ROSTER" />
      <p class="group-summary__lede">
        Archived by cohort. Roles stay on the card.
      </p>
      <div class="group-summary__chips">
        {chips.map((chip) => <span class="group-summary__chip app-chip">{chip}</span>)}
      </div>
    </section>

    <div class="app-star-divider" aria-hidden="true">
      <span class="app-star-divider__line"></span>
      <span class="app-star-divider__star">✦</span>
      <span class="app-star-divider__line"></span>
    </div>

    {cohorts.length === 0 ? (
      <div class="group-empty app-empty">
        APPLICATION ROSTER EMPTY. Add cohorts and members to <code>src/data/members.json</code>.
      </div>
    ) : (
      cohorts.map((entry) => (
        <CohortSection cohort={entry.cohort} memberCount={entry.members.length}>
          <div class="app-grid">
            {entry.members.map((member, i) => {
              const hp = 50 + ((i * 17) % 50);
              const mp = 30 + ((i * 23) % 70);
              return (
                <article class="app-card">
                  <span class="app-card__corner app-card__corner--tl" aria-hidden="true"></span>
                  <span class="app-card__corner app-card__corner--tr" aria-hidden="true"></span>
                  <span class="app-card__corner app-card__corner--bl" aria-hidden="true"></span>
                  <span class="app-card__corner app-card__corner--br" aria-hidden="true"></span>
                  <div class="app-card__badge px">★ READY</div>
                  <div class="app-card__top">
                    <div class="app-card__portrait">
                      {member.avatar ? (
                        <img class="member-avatar" src={member.avatar} alt={`${member.name} avatar`} loading="lazy" />
                      ) : (
                        <div class="member-avatar-fallback app-avatar-fb" aria-hidden="true">
                          {member.name.slice(0, 1)}
                        </div>
                      )}
                    </div>
                    <div class="app-card__info">
                      <h3>★ {member.name}</h3>
                      <p class="app-card__class px">CLASS: {member.focus}</p>
                    </div>
                  </div>
                  <p class="app-card__bio">{member.bio}</p>
                  <div class="app-card__stats" aria-hidden="true">
                    <div class="app-stat">
                      <span class="app-stat__label">HP</span>
                      <div class="app-stat__bar">
                        <div class="app-stat__fill app-stat__fill--hp" style={`width: ${hp}%`}></div>
                      </div>
                    </div>
                    <div class="app-stat">
                      <span class="app-stat__label">MP</span>
                      <div class="app-stat__bar">
                        <div class="app-stat__fill app-stat__fill--mp" style={`width: ${mp}%`}></div>
                      </div>
                    </div>
                  </div>
                  <div class="member-role-tags">
                    {member.roleTags.map((tag) => <span class="member-role-tag app-tag">✦ {tag}</span>)}
                  </div>
                  {member.links && Object.values(member.links).some(Boolean) && (
                    <div class="member-links">
                      {member.links.github && <a href={member.links.github}>GitHub</a>}
                      {member.links.bilibili && <a href={member.links.bilibili}>Bilibili</a>}
                      {member.links.blog && <a href={member.links.blog}>Blog</a>}
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </CohortSection>
      ))
    )}
  </main>
</Base>

<style>
  .group-page--application {
    --app-blue: #abd0ff;
    --app-yellow: #eaff8d;
    --app-pink: #ff6b9d;
    --app-cyan: #51ffd6;
    --app-night: #0a0e1a;
    color: #eaffd0;
  }

  /* -- Background FX -- */
  .app-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
  }

  .app-fx__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(171, 208, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(171, 208, 255, 0.06) 1px, transparent 1px);
    background-size: 8px 8px;
    opacity: 0.6;
  }

  /* -- Pixel stars -- */
  .app-fx__star {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--app-yellow);
    box-shadow:
      4px 0 0 0 var(--app-yellow),
      -4px 0 0 0 var(--app-yellow),
      0 4px 0 0 var(--app-yellow),
      0 -4px 0 0 var(--app-yellow);
  }

  .app-fx__star--a { top: 200px; right: 12%; opacity: 0.5; }
  .app-fx__star--b { top: 500px; left: 8%; opacity: 0.35; }
  .app-fx__star--c { top: 800px; right: 25%; opacity: 0.45; }
  .app-fx__star--d { top: 1100px; left: 20%; opacity: 0.3; }
  .app-fx__star--e { top: 1400px; right: 35%; opacity: 0.4; }

  @media (prefers-reduced-motion: no-preference) {
    .app-fx__star { animation: app-twinkle 2.4s steps(2) infinite; }
    .app-fx__star--b { animation-delay: 0.5s; }
    .app-fx__star--c { animation-delay: 1s; }
    .app-fx__star--d { animation-delay: 1.5s; }
    .app-fx__star--e { animation-delay: 0.3s; }
  }

  @keyframes app-twinkle {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 0.1; transform: scale(0.5); }
  }

  /* -- Hero -- */
  .app-hero {
    padding: 28px;
    background: linear-gradient(180deg, rgba(18, 27, 46, 0.95), rgba(10, 14, 26, 0.98));
    border-color: rgba(171, 208, 255, 0.25);
  }

  .app-hero__frame {
    position: relative;
    padding: 32px;
    border: 3px solid rgba(81, 255, 214, 0.35);
    background:
      linear-gradient(180deg, rgba(94, 142, 255, 0.08), rgba(81, 255, 214, 0.04));
    box-shadow:
      inset 0 0 0 3px rgba(10, 14, 26, 0.9),
      0 0 30px rgba(81, 255, 214, 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* -- Gradient accent line at bottom of hero frame -- */
  .app-hero__gradient-line {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--app-cyan), transparent);
    opacity: 0.6;
  }

  /* Pixel corner ornaments */
  .app-hero__corner {
    position: absolute;
    width: 12px;
    height: 12px;
    background: var(--app-yellow);
    box-shadow: inset 0 0 0 3px var(--app-night);
  }

  .app-hero__corner--tl { top: -3px; left: -3px; }
  .app-hero__corner--tr { top: -3px; right: -3px; }
  .app-hero__corner--bl { bottom: -3px; left: -3px; }
  .app-hero__corner--br { bottom: -3px; right: -3px; }

  .app-hero__eyebrow {
    margin-bottom: 16px;
    font-size: 10px;
    color: var(--app-blue);
  }

  .app-hero__title {
    font-size: clamp(24px, 5vw, 52px);
    line-height: 1.2;
    margin-bottom: 12px;
    color: var(--app-yellow);
    text-shadow:
      3px 3px 0 rgba(255, 107, 157, 0.3),
      0 0 25px rgba(81, 255, 214, 0.3),
      0 0 50px rgba(81, 255, 214, 0.15);
  }

  .app-hero__prompt {
    font-size: 12px;
    color: var(--app-cyan);
    margin-bottom: 18px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .app-hero__prompt { animation: app-blink 1s steps(2) infinite; }
  }

  @keyframes app-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .app-hero__desc {
    font-size: 22px;
    line-height: 1.45;
    max-width: 640px;
    color: rgba(234, 255, 208, 0.85);
  }

  /* -- Star divider (irys-style) -- */
  .app-star-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 28px;
    max-width: 960px;
    margin: 0 auto;
  }

  .app-star-divider__line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(81, 255, 214, 0.3), transparent);
  }

  .app-star-divider__star {
    color: var(--app-cyan);
    font-size: 14px;
    opacity: 0.6;
    text-shadow: 0 0 10px rgba(81, 255, 214, 0.4);
  }

  @media (prefers-reduced-motion: no-preference) {
    .app-star-divider__star {
      animation: app-star-pulse 3s ease-in-out infinite;
    }
  }

  @keyframes app-star-pulse {
    0%, 100% { opacity: 0.6; text-shadow: 0 0 10px rgba(81, 255, 214, 0.4); }
    50% { opacity: 1; text-shadow: 0 0 18px rgba(81, 255, 214, 0.7); }
  }

  /* -- Summary -- */
  .app-summary {
    border-color: rgba(171, 208, 255, 0.2);
    background: rgba(10, 14, 26, 0.85);
  }

  .app-chip {
    border-color: rgba(171, 208, 255, 0.3);
    color: var(--app-blue);
  }

  /* -- Card grid -- */
  .app-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    position: relative;
  }

  /* Vertical gradient accent lines as card separators */
  .app-grid::before,
  .app-grid::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(81, 255, 214, 0.2), transparent);
    pointer-events: none;
    z-index: 1;
  }

  .app-grid::before { left: -9px; }
  .app-grid::after { right: -9px; }

  .app-card {
    position: relative;
    padding: 20px;
    border: 2px solid transparent;
    background:
      linear-gradient(rgba(16, 26, 44, 0.96), rgba(10, 14, 26, 0.98)) padding-box,
      linear-gradient(135deg, rgba(81, 255, 214, 0.3), rgba(171, 208, 255, 0.15), rgba(81, 255, 214, 0.1)) border-box;
    box-shadow:
      inset 0 0 0 3px rgba(10, 14, 26, 0.8),
      0 4px 16px rgba(0, 0, 0, 0.4);
    transition: transform 200ms ease, box-shadow 200ms ease;
    overflow: hidden;
  }

  /* Speed lines on hover */
  .app-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-conic-gradient(
      from 0deg at 50% 120%,
      transparent 0deg,
      rgba(171, 208, 255, 0.03) 2deg,
      transparent 4deg
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }

  /* -- Card corner ornaments -- */
  .app-card__corner {
    position: absolute;
    width: 8px;
    height: 8px;
    background: var(--app-blue);
    opacity: 0.5;
  }

  .app-card__corner--tl { top: 0; left: 0; }
  .app-card__corner--tr { top: 0; right: 0; }
  .app-card__corner--bl { bottom: 0; left: 0; }
  .app-card__corner--br { bottom: 0; right: 0; }

  .app-card__badge {
    display: inline-block;
    margin-bottom: 14px;
    padding: 5px 10px;
    font-size: 9px;
    color: var(--app-night);
    background: var(--app-yellow);
    letter-spacing: 0.05em;
  }

  .app-card__top {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 14px;
  }

  .app-card__portrait {
    flex: 0 0 auto;
    border: 2px solid var(--app-blue);
    box-shadow: inset 0 0 0 2px rgba(10, 14, 26, 0.8);
    padding: 3px;
  }

  .app-card__portrait .member-avatar,
  .app-card__portrait .member-avatar-fallback {
    width: 64px;
    height: 64px;
    border-radius: 0;
    border: none;
  }

  .app-avatar-fb {
    background: linear-gradient(180deg, rgba(171, 208, 255, 0.18), rgba(234, 255, 141, 0.12));
    color: #dffcb0;
    font-size: 20px;
  }

  .app-card__info h3 {
    font-family: 'Press Start 2P', monospace;
    font-size: 13px;
    line-height: 1.4;
    color: var(--app-yellow);
  }

  .app-card__class {
    font-size: 9px;
    color: var(--app-blue);
    margin-top: 6px;
    letter-spacing: 0.06em;
  }

  .app-card__bio {
    line-height: 1.5;
    color: rgba(234, 255, 208, 0.8);
    margin-bottom: 14px;
  }

  /* -- Stat bars -- */
  .app-card__stats {
    margin-bottom: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .app-stat {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .app-stat__label {
    font-family: 'Press Start 2P', monospace;
    font-size: 8px;
    color: var(--app-blue);
    width: 24px;
    flex: 0 0 auto;
  }

  .app-stat__bar {
    flex: 1;
    height: 10px;
    background: rgba(171, 208, 255, 0.1);
    border: 1px solid rgba(171, 208, 255, 0.2);
    position: relative;
    overflow: hidden;
  }

  .app-stat__fill {
    height: 100%;
    transition: width 600ms ease;
  }

  .app-stat__fill--hp {
    background: linear-gradient(90deg, #ff4444, #ff6b6b);
    box-shadow: 0 0 6px rgba(255, 68, 68, 0.4);
  }

  .app-stat__fill--mp {
    background: linear-gradient(90deg, #4488ff, #6baaff);
    box-shadow: 0 0 6px rgba(68, 136, 255, 0.4);
  }

  /* -- Tags -- */
  .app-tag {
    border-color: rgba(171, 208, 255, 0.3);
    background: rgba(94, 142, 255, 0.08);
    font-size: 13px;
    color: var(--app-blue);
  }

  /* -- Empty state -- */
  .app-empty {
    border-color: rgba(171, 208, 255, 0.3);
    color: var(--app-blue);
    background: rgba(10, 14, 26, 0.6);
  }

  /* -- Hover effects -- */
  @media (prefers-reduced-motion: no-preference) {
    .app-card:hover {
      transform: scale(1.05);
      box-shadow:
        inset 0 0 0 3px rgba(10, 14, 26, 0.8),
        0 0 20px rgba(81, 255, 214, 0.15),
        0 0 40px rgba(81, 255, 214, 0.08),
        0 8px 32px rgba(0, 0, 0, 0.5);
    }

    .app-card:hover::before {
      opacity: 1;
    }

    .app-card:hover .app-card__corner {
      background: var(--app-cyan);
      opacity: 0.8;
      box-shadow: 0 0 8px rgba(81, 255, 214, 0.4);
    }

    .app-card:hover .app-card__badge {
      box-shadow: 0 0 12px rgba(81, 255, 214, 0.25);
    }
  }

  /* -- Responsive -- */
  @media (max-width: 720px) {
    .app-hero,
    .app-hero__frame,
    .app-card {
      padding: 14px;
    }

    .app-card__top {
      align-items: flex-start;
    }

    .app-hero__desc {
      font-size: 20px;
    }

    .app-card__info h3 {
      font-size: 11px;
    }
  }
</style>
