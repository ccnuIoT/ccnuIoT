---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import GroupPageNav from '../../components/GroupPageNav.astro';
import CohortSection from '../../components/CohortSection.astro';
import { getGroupCohorts } from '../../data/members';

const cohorts = getGroupCohorts('application');
const chips = ['UI', 'MOBILE', 'WEB', 'BACKEND'];
---

<Base title="Application Division — CCNU IoT">
  <main class="group-page group-page--application">
    <div class="application-page-fx" aria-hidden="true">
      <div class="application-page-fx__grid"></div>
      <span class="application-page-fx__chip application-page-fx__chip--a"></span>
      <span class="application-page-fx__chip application-page-fx__chip--b"></span>
      <span class="application-page-fx__chip application-page-fx__chip--c"></span>
      <span class="application-page-fx__chip application-page-fx__chip--d"></span>
      <span class="application-page-fx__star application-page-fx__star--a"></span>
      <span class="application-page-fx__star application-page-fx__star--b"></span>
      <span class="application-page-fx__star application-page-fx__star--c"></span>
    </div>
    <GroupPageNav current="application" />

    <section class="application-hero group-shell">
      <div class="application-hero__screen">
        <p class="application-hero__eyebrow px">DIVISION 03 / APPLICATION</p>
        <h1 class="application-hero__title">SELECT YOUR PARTY</h1>
        <p class="application-hero__desc">
          UI, mobile, web, services. Built to ship.
        </p>
      </div>
    </section>

    <section class="group-summary group-shell">
      <SectionHead marker="SEC.P3" label="PLAYER ROSTER" />
      <p class="group-summary__lede">
        Archived by cohort. Roles stay on the card.
      </p>
      <div class="group-summary__chips">
        {chips.map((chip) => <span class="group-summary__chip">{chip}</span>)}
      </div>
    </section>

    {cohorts.length === 0 ? (
      <div class="group-empty">
        APPLICATION ROSTER EMPTY. Add cohorts and members to <code>src/data/members.json</code>.
      </div>
    ) : (
      cohorts.map((entry) => (
        <CohortSection cohort={entry.cohort} memberCount={entry.members.length}>
          <div class="application-grid">
            {entry.members.map((member) => (
              <article class="application-card">
                <div class="application-card__badge px">READY</div>
                <div class="application-card__top">
                  {member.avatar ? (
                    <img class="member-avatar" src={member.avatar} alt={`${member.name} avatar`} loading="lazy" />
                  ) : (
                    <div class="member-avatar-fallback application-avatar-fallback" aria-hidden="true">
                      {member.name.slice(0, 1)}
                    </div>
                  )}
                  <div>
                    <h3>{member.name}</h3>
                    <p class="application-card__focus">{member.focus}</p>
                  </div>
                </div>
                <p class="application-card__bio">{member.bio}</p>
                <div class="member-role-tags">
                  {member.roleTags.map((tag) => <span class="member-role-tag">{tag}</span>)}
                </div>
                {member.links && Object.values(member.links).some(Boolean) && (
                  <div class="member-links">
                    {member.links.github && <a href={member.links.github}>GitHub</a>}
                    {member.links.bilibili && <a href={member.links.bilibili}>Bilibili</a>}
                    {member.links.blog && <a href={member.links.blog}>Blog</a>}
                  </div>
                )}
              </article>
            ))}
          </div>
        </CohortSection>
      ))
    )}
  </main>
</Base>

<style>
  .group-page--application {
    color: #eaffd0;
  }

  .application-page-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
  }

  .application-page-fx__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(171, 208, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(171, 208, 255, 0.08) 1px, transparent 1px);
    background-size: 8px 8px;
    opacity: 0.5;
  }

  .application-page-fx__chip {
    position: absolute;
    width: 24px;
    height: 24px;
    background:
      linear-gradient(180deg, rgba(234, 255, 141, 0.4), rgba(94, 142, 255, 0.3));
    box-shadow:
      4px 0 0 0 rgba(234, 255, 141, 0.2),
      0 4px 0 0 rgba(94, 142, 255, 0.2),
      4px 4px 0 0 rgba(8, 13, 22, 0.4);
    image-rendering: pixelated;
  }

  .application-page-fx__chip--a { top: 180px; left: 4%; transform: rotate(0deg); }
  .application-page-fx__chip--b { top: 460px; right: 6%; transform: rotate(45deg); }
  .application-page-fx__chip--c { top: 820px; left: 12%; transform: rotate(0deg); }
  .application-page-fx__chip--d { top: 1180px; right: 14%; transform: rotate(45deg); }

  .application-page-fx__star {
    position: absolute;
    width: 8px;
    height: 8px;
    background: #eaff8d;
    box-shadow:
      8px 0 0 0 #eaff8d,
      -8px 0 0 0 #eaff8d,
      0 8px 0 0 #eaff8d,
      0 -8px 0 0 #eaff8d;
  }

  .application-page-fx__star--a { top: 320px; right: 18%; opacity: 0.5; }
  .application-page-fx__star--b { top: 660px; left: 26%; opacity: 0.4; }
  .application-page-fx__star--c { top: 1040px; right: 30%; opacity: 0.45; }

  @media (prefers-reduced-motion: no-preference) {
    .application-page-fx__star {
      animation: application-twinkle 2.4s steps(2) infinite;
    }

    .application-page-fx__star--b { animation-delay: 0.8s; }
    .application-page-fx__star--c { animation-delay: 1.6s; }
  }

  @keyframes application-twinkle {
    0%, 100% { opacity: 0.45; transform: scale(1); }
    50% { opacity: 0.15; transform: scale(0.7); }
  }

  .application-hero {
    padding: 28px;
    background:
      linear-gradient(180deg, rgba(18, 27, 46, 0.94), rgba(8, 13, 22, 0.98));
    border-color: rgba(138, 187, 255, 0.24);
  }

  .application-hero__screen {
    padding: 24px;
    border: 4px solid rgba(138, 187, 255, 0.34);
    background:
      linear-gradient(180deg, rgba(94, 142, 255, 0.14), rgba(153, 255, 131, 0.08));
    box-shadow: inset 0 0 0 4px rgba(8, 13, 22, 0.9);
  }

  .application-hero__eyebrow {
    margin-bottom: 16px;
    font-size: 10px;
    color: #abd0ff;
  }

  .application-hero__title {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(24px, 5vw, 52px);
    line-height: 1.2;
    margin-bottom: 18px;
    color: #eaff8d;
  }

  .application-hero__desc {
    font-size: 22px;
    line-height: 1.45;
    max-width: 640px;
  }

  .application-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }

  .application-card {
    position: relative;
    padding: 18px;
    border: 2px solid rgba(171, 208, 255, 0.34);
    background: linear-gradient(180deg, rgba(16, 26, 44, 0.95), rgba(9, 16, 28, 0.98));
    box-shadow: inset 0 0 0 2px rgba(234, 255, 141, 0.08);
  }

  .application-card__badge {
    display: inline-block;
    margin-bottom: 14px;
    padding: 6px 10px;
    font-size: 10px;
    color: #08101c;
    background: #eaff8d;
  }

  .application-card__top {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .application-avatar-fallback {
    background: linear-gradient(180deg, rgba(171, 208, 255, 0.18), rgba(234, 255, 141, 0.14));
    color: #dffcb0;
    border: 1px solid rgba(171, 208, 255, 0.3);
  }

  .application-card h3 {
    font-size: 28px;
    line-height: 1;
  }

  .application-card__focus {
    margin-top: 8px;
    color: #abd0ff;
  }

  .application-card__bio {
    margin-top: 14px;
    line-height: 1.45;
  }

  @media (prefers-reduced-motion: no-preference) {
    .application-card:hover {
      transform: translateY(-2px) scale(1.01);
    }
  }

  @media (max-width: 720px) {
    .application-hero,
    .application-hero__screen,
    .application-card {
      padding: 16px;
    }

    .application-card__top {
      align-items: flex-start;
    }

    .application-hero__desc {
      font-size: 20px;
    }
  }
</style>
