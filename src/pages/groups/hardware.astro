---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import GroupPageNav from '../../components/GroupPageNav.astro';
import CohortSection from '../../components/CohortSection.astro';
import { getGroupCohorts } from '../../data/members';

const cohorts = getGroupCohorts('hardware');
const chips = ['PCB', 'EMBEDDED', 'SENSORS', 'DEBUG'];
---

<Base title="Hardware Division — CCNU IoT">
  <main class="group-page group-page--hardware">
    <div class="hw-fx" aria-hidden="true">
      <div class="hw-fx__noise"></div>
      <span class="hw-fx__trace hw-fx__trace--a"></span>
      <span class="hw-fx__trace hw-fx__trace--b"></span>
      <span class="hw-fx__trace hw-fx__trace--c"></span>
      <span class="hw-fx__trace hw-fx__trace--d"></span>
      <span class="hw-fx__trace hw-fx__trace--e"></span>
      <span class="hw-fx__via hw-fx__via--a"></span>
      <span class="hw-fx__via hw-fx__via--b"></span>
      <span class="hw-fx__via hw-fx__via--c"></span>
      <span class="hw-fx__via hw-fx__via--d"></span>
      <span class="hw-fx__led hw-fx__led--a"></span>
      <span class="hw-fx__led hw-fx__led--b"></span>
      <span class="hw-fx__led hw-fx__led--c"></span>
      <span class="hw-fx__orbit hw-fx__orbit--2"></span>
      <span class="hw-fx__orbit hw-fx__orbit--3"></span>
      <span class="hw-fx__glow hw-fx__glow--tr"></span>
      <span class="hw-fx__glow hw-fx__glow--bl"></span>
    </div>
    <GroupPageNav current="hardware" />

    <section class="hw-hero group-shell">
      <div class="hw-hero__traces" aria-hidden="true"></div>
      <div class="hw-hero__heat" aria-hidden="true"></div>
      <div class="hw-hero__copy">
        <p class="hw-hero__eyebrow px">DIVISION 01 / HARDWARE</p>
        <h1 class="hw-hero__title glow-hard">CIRCUIT / SIGNAL / CONTROL</h1>
        <p class="hw-hero__desc">
          Board files, solder heat, signal checks, field-ready modules.
        </p>
      </div>
    </section>

    <section class="group-summary group-shell hw-summary">
      <SectionHead marker="SEC.H1" label="BOARD OVERVIEW" />
      <p class="group-summary__lede">
        Archived by cohort. Roles stay on the card.
      </p>
      <div class="group-summary__chips">
        {chips.map((chip) => <span class="group-summary__chip hw-chip">{chip}</span>)}
      </div>
    </section>

    {cohorts.length === 0 ? (
      <div class="group-empty hw-empty">
        HARDWARE ROSTER EMPTY. Add cohorts and members to <code>src/data/members.json</code>.
      </div>
    ) : (
      cohorts.map((entry) => (
        <CohortSection cohort={entry.cohort} memberCount={entry.members.length}>
          <div class="hw-card-grid">
            {entry.members.map((member, i) => (
              <article class="hw-card">
                <span class="hw-card__pad hw-card__pad--tl" aria-hidden="true"></span>
                <span class="hw-card__pad hw-card__pad--tr" aria-hidden="true"></span>
                <span class="hw-card__pad hw-card__pad--bl" aria-hidden="true"></span>
                <span class="hw-card__pad hw-card__pad--br" aria-hidden="true"></span>
                <div class="hw-card__ic">
                  {member.avatar ? (
                    <img class="member-avatar" src={member.avatar} alt={`${member.name} avatar`} loading="lazy" />
                  ) : (
                    <div class="member-avatar-fallback hw-avatar-fb" aria-hidden="true">
                      {member.name.slice(0, 1)}
                    </div>
                  )}
                </div>
                <div class="hw-card__body">
                  <div class="hw-card__header">
                    <h3>{member.name}</h3>
                    <span class="hw-card__focus">{member.focus}</span>
                  </div>
                  <p class="hw-card__bio">{member.bio}</p>
                  <div class="member-role-tags">
                    {member.roleTags.map((tag, ti) => (
                      <span class="member-role-tag hw-tag">
                        <span class="hw-tag__ref">{String.fromCharCode(82 + ti)}{i + 1}</span>
                        {tag}
                      </span>
                    ))}
                  </div>
                  {member.links && Object.values(member.links).some(Boolean) && (
                    <div class="member-links">
                      {member.links.github && <a href={member.links.github}>GitHub</a>}
                      {member.links.bilibili && <a href={member.links.bilibili}>Bilibili</a>}
                      {member.links.blog && <a href={member.links.blog}>Blog</a>}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </CohortSection>
      ))
    )}
  </main>
</Base>

<style>
  /* ── Palette ── */
  .group-page--hardware {
    --hw-copper: #8b6914;
    --hw-copper-lt: #c4962a;
    --hw-solder: #ffcc73;
    --hw-mask: #3a5a28;
    --hw-silk: #c4c4c4;
    --hw-fr4: #4a3f20;
    --hw-bg: #0d0a04;
    color: #dfffe8;
  }

  /* ── Noise overlay ── */
  .hw-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
  }

  .hw-fx__noise {
    position: absolute;
    inset: -20%;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 4 4' xmlns='http://www.w3.org/2000/svg'%3E%3Crect width='1' height='1' fill='%23ffffff' opacity='0.05'/%3E%3Crect x='2' y='2' width='1' height='1' fill='%23ffffff' opacity='0.04'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 4px 4px;
    opacity: 0.14;
    mix-blend-mode: screen;
  }

  /* ── Grid overlay (structured background grid) ── */
  .hw-fx::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.08;
    background-image:
      linear-gradient(rgba(139, 105, 20, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(139, 105, 20, 0.06) 1px, transparent 1px),
      /* intersection dots */
      radial-gradient(circle 1px, rgba(139, 105, 20, 0.12) 1px, transparent 1px);
    background-size: 60px 60px, 60px 60px, 60px 60px;
    pointer-events: none;
  }

  /* ── Traces (broken PCB traces scattered across page) ── */
  .hw-fx__trace {
    position: absolute;
    display: block;
    background: linear-gradient(90deg, rgba(139, 105, 20, 0.25), rgba(139, 105, 20, 0.05));
    height: 2px;
  }

  .hw-fx__trace--a { top: 180px; left: 2%; width: 28%; transform: rotate(0deg); }
  .hw-fx__trace--b { top: 420px; right: 4%; width: 22%; transform: rotate(0deg); }
  .hw-fx__trace--c { top: 700px; left: 10%; width: 35%; transform: rotate(2deg); }
  .hw-fx__trace--d { top: 950px; right: 8%; width: 18%; transform: rotate(-1deg); }
  .hw-fx__trace--e { top: 1200px; left: 25%; width: 40%; transform: rotate(0deg); }

  /* ── Vias (small ring shapes) ── */
  .hw-fx__via {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid rgba(139, 105, 20, 0.35);
    background: transparent;
  }

  .hw-fx__via--a { top: 260px; left: 28%; }
  .hw-fx__via--b { top: 550px; right: 22%; }
  .hw-fx__via--c { top: 840px; left: 42%; }
  .hw-fx__via--d { top: 1100px; right: 38%; }

  /* ── LEDs (flickering test points) ── */
  .hw-fx__led {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hw-solder);
    box-shadow: 0 0 8px rgba(255, 204, 115, 0.5), 0 0 20px rgba(255, 204, 115, 0.2);
  }

  .hw-fx__led--a { top: 300px; left: 30%; }
  .hw-fx__led--b { top: 680px; right: 24%; }
  .hw-fx__led--c { top: 1050px; left: 50%; }

  @media (prefers-reduced-motion: no-preference) {
    .hw-fx__led--a { animation: hw-pulse 2.5s ease-in-out infinite; }
    .hw-fx__led--b { animation: hw-pulse 3s ease-in-out infinite 0.8s; }
    .hw-fx__led--c { animation: hw-pulse 2.2s ease-in-out infinite 1.5s; }
    .hw-fx__noise { animation: hw-noise-drift 8s linear infinite; }
    .hw-hero::before { animation: hw-orbit 20s linear infinite; }
  }

  @keyframes hw-pulse {
    0%, 100% { opacity: 0.4; box-shadow: 0 0 4px rgba(255, 204, 115, 0.2); }
    50% { opacity: 1; box-shadow: 0 0 12px rgba(255, 204, 115, 0.6), 0 0 28px rgba(255, 204, 115, 0.25); }
  }

  @keyframes hw-orbit {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes hw-noise-drift {
    0% { transform: translate(0, 0); }
    50% { transform: translate(-10px, -8px); }
    100% { transform: translate(0, 0); }
  }

  /* ── Hero ── */
  .hw-hero {
    position: relative;
    overflow: hidden;
    padding: 36px;
    border-color: rgba(139, 105, 20, 0.35);
    background:
      radial-gradient(ellipse 80% 60% at 50% 40%, rgba(139, 105, 20, 0.18), transparent 70%),
      radial-gradient(circle at 30% 60%, rgba(143, 126, 119, 0.12), transparent 50%),
      radial-gradient(ellipse at 70% 20%, rgba(58, 90, 40, 0.2), transparent 50%),
      radial-gradient(ellipse at 20% 80%, rgba(139, 105, 20, 0.15), transparent 40%),
      radial-gradient(ellipse at 85% 65%, rgba(58, 90, 40, 0.12), transparent 45%),
      linear-gradient(180deg, #1a1208, #0d0a04);
  }

  .hw-hero__traces {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(0deg, transparent 49.5%, rgba(139, 105, 20, 0.12) 49.5%, rgba(139, 105, 20, 0.12) 50.5%, transparent 50.5%),
      linear-gradient(90deg, transparent 49.5%, rgba(139, 105, 20, 0.08) 49.5%, rgba(139, 105, 20, 0.08) 50.5%, transparent 50.5%);
    background-size: 48px 48px;
    opacity: 0.6;
    pointer-events: none;
    mask-image: linear-gradient(135deg, black 30%, transparent 35%, black 45%, transparent 50%, black 65%, transparent 70%, black 80%);
    -webkit-mask-image: linear-gradient(135deg, black 30%, transparent 35%, black 45%, transparent 50%, black 65%, transparent 70%, black 80%);
  }

  .hw-hero__heat {
    position: absolute;
    width: 350px;
    height: 350px;
    border-radius: 50%;
    top: 20%;
    right: 15%;
    background: radial-gradient(circle, rgba(139, 105, 20, 0.25), rgba(90, 50, 10, 0.15), transparent 70%);
    filter: blur(80px);
    pointer-events: none;
  }

  .hw-hero__copy {
    position: relative;
    max-width: 760px;
  }

  .hw-hero__eyebrow {
    color: var(--hw-copper-lt);
    margin-bottom: 18px;
    font-size: 10px;
  }

  .hw-hero__title {
    font-size: clamp(34px, 7vw, 76px);
    line-height: 1;
    margin-bottom: 18px;
    color: var(--hw-silk);
    text-shadow:
      0 0 40px rgba(139, 105, 20, 0.2),
      0 0 80px rgba(139, 105, 20, 0.08),
      2px 2px 0 rgba(139, 105, 20, 0.3),
      -1px -1px 0 rgba(0, 0, 0, 0.5);
  }

  .hw-hero__desc {
    max-width: 620px;
    font-size: 24px;
    line-height: 1.4;
    color: rgba(223, 255, 232, 0.85);
  }

  /* ── Orbital ring (animated circle around hero center) ── */
  .hw-hero::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 420px;
    height: 420px;
    margin-top: -210px;
    margin-left: -210px;
    border-radius: 50%;
    border: 1px solid rgba(139, 105, 20, 0.15);
    box-shadow:
      inset 0 0 40px rgba(139, 105, 20, 0.1),
      0 0 20px rgba(139, 105, 20, 0.08);
    pointer-events: none;
  }

  /* ── Mist / fog layer ── */
  .hw-hero::after {
    content: '';
    position: absolute;
    bottom: -20%;
    left: -10%;
    width: 80%;
    height: 60%;
    background: radial-gradient(ellipse, rgba(139, 105, 20, 0.06), transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }

  /* ── Summary section ── */
  .hw-summary {
    border-color: rgba(139, 105, 20, 0.25);
    background: rgba(13, 10, 4, 0.85);
  }

  .hw-chip {
    border-color: rgba(139, 105, 20, 0.35);
    color: var(--hw-copper-lt);
  }

  /* ── Card grid ── */
  .hw-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 18px;
  }

  .hw-card {
    position: relative;
    display: flex;
    gap: 18px;
    padding: 22px;
    border: 2px solid rgba(139, 105, 20, 0.4);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(139, 105, 20, 0.06), transparent 60%),
      linear-gradient(145deg, rgba(26, 18, 8, 0.97), rgba(13, 10, 4, 0.98));
    box-shadow:
      inset 0 0 0 1px rgba(58, 90, 40, 0.15),
      0 2px 12px rgba(0, 0, 0, 0.4);
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
  }

  /* ── Solder pads (corner dots) ── */
  .hw-card__pad {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--hw-solder);
    box-shadow: 0 0 6px rgba(255, 204, 115, 0.4);
    opacity: 0.6;
    transition: opacity 200ms ease, box-shadow 200ms ease;
  }

  .hw-card__pad--tl { top: 6px; left: 6px; }
  .hw-card__pad--tr { top: 6px; right: 6px; }
  .hw-card__pad--bl { bottom: 6px; left: 6px; }
  .hw-card__pad--br { bottom: 6px; right: 6px; }

  /* ── Corner bracket ornaments (Astral Frontier style) ── */
  .hw-card::before {
    content: '';
    position: absolute;
    top: -4px;
    left: -4px;
    width: 18px;
    height: 18px;
    border-top: 2px solid var(--hw-copper);
    border-left: 2px solid var(--hw-copper);
    opacity: 0.3;
    transition: opacity 200ms ease, box-shadow 200ms ease;
    pointer-events: none;
    z-index: 1;
  }

  .hw-card::after {
    content: '';
    position: absolute;
    bottom: -4px;
    right: -4px;
    width: 18px;
    height: 18px;
    border-bottom: 2px solid var(--hw-copper);
    border-right: 2px solid var(--hw-copper);
    opacity: 0.3;
    transition: opacity 200ms ease, box-shadow 200ms ease;
    pointer-events: none;
    z-index: 1;
  }

  /* ── IC chip frame for avatar ── */
  .hw-card__ic {
    flex: 0 0 auto;
    position: relative;
    border: 2px solid rgba(139, 105, 20, 0.5);
    padding: 4px;
    background: rgba(74, 63, 32, 0.3);
  }

  .hw-card__ic::before,
  .hw-card__ic::after {
    content: '';
    position: absolute;
    background: rgba(139, 105, 20, 0.3);
  }

  /* IC pin markers — left side */
  .hw-card__ic::before {
    left: -6px;
    top: 15%;
    width: 4px;
    height: 8px;
    box-shadow:
      0 16px 0 rgba(139, 105, 20, 0.3),
      0 32px 0 rgba(139, 105, 20, 0.3),
      0 48px 0 rgba(139, 105, 20, 0.3);
  }

  /* IC pin markers — right side */
  .hw-card__ic::after {
    right: -6px;
    top: 15%;
    width: 4px;
    height: 8px;
    box-shadow:
      0 16px 0 rgba(139, 105, 20, 0.3),
      0 32px 0 rgba(139, 105, 20, 0.3),
      0 48px 0 rgba(139, 105, 20, 0.3);
  }

  .hw-card__ic .member-avatar,
  .hw-card__ic .member-avatar-fallback {
    width: 72px;
    height: 72px;
    border-radius: 0;
    border: none;
  }

  .hw-avatar-fb {
    background: linear-gradient(180deg, rgba(139, 105, 20, 0.25), rgba(58, 90, 40, 0.15));
    color: var(--hw-solder);
    border: 1px solid rgba(139, 105, 20, 0.3);
    font-size: 22px;
  }

  .hw-card__body {
    min-width: 0;
    flex: 1;
  }

  .hw-card__header {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 10px;
  }

  .hw-card__header h3 {
    font-size: 28px;
    line-height: 1;
    color: var(--hw-silk);
  }

  .hw-card__focus {
    color: var(--hw-copper-lt);
    letter-spacing: 0.06em;
    font-size: 15px;
  }

  .hw-card__bio {
    line-height: 1.5;
    color: rgba(223, 255, 232, 0.8);
  }

  /* ── Tags as component reference designators ── */
  .hw-tag {
    border-color: rgba(139, 105, 20, 0.4);
    background: rgba(74, 63, 32, 0.2);
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .hw-tag__ref {
    font-family: 'Press Start 2P', monospace;
    font-size: 8px;
    color: var(--hw-solder);
    opacity: 0.7;
  }

  /* ── Empty state ── */
  .hw-empty {
    border-color: rgba(139, 105, 20, 0.35);
    color: var(--hw-copper-lt);
    background: rgba(13, 10, 4, 0.6);
  }

  /* ── Hover effects ── */
  @media (prefers-reduced-motion: no-preference) {
    .hw-card:hover {
      transform: translateY(-3px);
      border-color: rgba(139, 105, 20, 0.65);
      box-shadow:
        inset 0 0 0 1px rgba(58, 90, 40, 0.25),
        0 0 20px rgba(139, 105, 20, 0.15),
        0 8px 32px rgba(0, 0, 0, 0.5);
    }

    .hw-card:hover .hw-card__pad {
      opacity: 1;
      box-shadow: 0 0 10px rgba(255, 204, 115, 0.6);
    }

    .hw-card:hover::before,
    .hw-card:hover::after {
      opacity: 1;
      box-shadow: 0 0 8px rgba(139, 105, 20, 0.4);
    }
  }

  /* ── Additional orbital rings ── */
  .hw-fx__orbit {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(139, 105, 20, 0.2);
    pointer-events: none;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .hw-fx__orbit--2 {
    width: 560px;
    height: 560px;
    border-style: dashed;
    opacity: 0.3;
  }

  .hw-fx__orbit--3 {
    width: 720px;
    height: 720px;
    border-style: dotted;
    opacity: 0.15;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hw-fx__orbit--2 { animation: hw-orbit 14s linear infinite reverse; }
    .hw-fx__orbit--3 { animation: hw-orbit 25s linear infinite; }
  }

  /* ── Page-level glow blobs ── */
  .hw-fx__glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .hw-fx__glow--tr {
    width: 500px;
    height: 500px;
    top: 10%;
    right: -10%;
    background: radial-gradient(circle, rgba(143, 126, 119, 0.08), transparent 70%);
    filter: blur(100px);
  }

  .hw-fx__glow--bl {
    width: 400px;
    height: 400px;
    bottom: 10%;
    left: -10%;
    background: radial-gradient(circle, rgba(139, 105, 20, 0.06), transparent 70%);
    filter: blur(80px);
  }

  /* ── Card solder-pad pulse ── */
  @media (prefers-reduced-motion: no-preference) {
    .hw-card__pad {
      animation: hw-pad-pulse 4s ease-in-out infinite;
    }
  }

  @keyframes hw-pad-pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.7; }
  }

  /* ── Hero copy corner brackets ── */
  .hw-hero__copy::before,
  .hw-hero__copy::after {
    content: '';
    position: absolute;
    width: 24px;
    height: 24px;
    border-color: rgba(139, 105, 20, 0.4);
    border-style: solid;
    pointer-events: none;
  }

  .hw-hero__copy::before {
    top: -12px;
    left: -12px;
    border-width: 2px 0 0 2px;
  }

  .hw-hero__copy::after {
    bottom: -12px;
    right: -12px;
    border-width: 0 2px 2px 0;
  }

  /* ── Responsive ── */
  @media (max-width: 720px) {
    .hw-hero,
    .hw-card {
      padding: 18px;
    }

    .hw-card {
      flex-direction: column;
    }

    .hw-hero__desc {
      font-size: 20px;
    }

    .hw-card__ic::before,
    .hw-card__ic::after {
      display: none;
    }
  }
</style>
