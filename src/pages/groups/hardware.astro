---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import GroupPageNav from '../../components/GroupPageNav.astro';
import CohortSection from '../../components/CohortSection.astro';
import { getGroupCohorts } from '../../data/members';

const cohorts = getGroupCohorts('hardware');
const chips = ['PCB', 'EMBEDDED', 'SENSORS', 'DEBUG'];
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const assetPath = (path: string) => path.startsWith('/') ? `${basePath}${path.replace(/^\//, '')}` : path;
---

<Base title="Hardware Division - CCNU IoT">
  <main class="group-page group-page--hardware">
    <div class="hw-fx" aria-hidden="true">
      <div class="hw-fx__blueprint"></div>
      <span class="hw-fx__trace hw-fx__trace--a"></span>
      <span class="hw-fx__trace hw-fx__trace--b"></span>
      <span class="hw-fx__trace hw-fx__trace--c"></span>
      <span class="hw-fx__mark hw-fx__mark--a">TP-12</span>
      <span class="hw-fx__mark hw-fx__mark--b">GND BUS</span>
      <span class="hw-fx__mark hw-fx__mark--c">REV 0.4</span>
    </div>

    <GroupPageNav current="hardware" />

    <section class="hw-hero" aria-labelledby="hardware-title">
      <div class="hw-hero__plate">
        <div class="hw-hero__copy">
          <p class="hw-hero__eyebrow px">DIVISION 01 / HARDWARE LAB</p>
          <h1 id="hardware-title" class="hw-hero__title">BOARD / SIGNAL / DEBUG</h1>
          <p class="hw-hero__desc">
            Board bring-up, field wiring, sensor checks, and the parts that make ideas survive outside the editor.
          </p>
          <div class="hw-hero__readouts" aria-hidden="true">
            <span>VIN 5.0V</span>
            <span>BUS OK</span>
            <span>CAL 03</span>
          </div>
        </div>

        <div class="hw-instrument" aria-hidden="true">
          <div class="hw-instrument__scope">
            <div class="hw-instrument__grid"></div>
            <svg class="hw-instrument__wave" viewBox="0 0 360 160" preserveAspectRatio="none">
              <path d="M0 92 C28 92 28 54 56 54 S84 130 112 130 S140 70 168 70 S196 98 224 98 S252 42 280 42 S308 118 336 118 S348 84 360 84" />
            </svg>
            <span class="hw-instrument__sweep"></span>
          </div>
          <div class="hw-instrument__controls">
            <span class="hw-knob hw-knob--a"></span>
            <span class="hw-knob hw-knob--b"></span>
            <span class="hw-port"></span>
            <span class="hw-led"></span>
          </div>
          <div class="hw-fixture">
            <span></span><span></span><span></span><span></span><span></span>
          </div>
        </div>
      </div>
    </section>

    <section class="group-summary group-shell hw-summary">
      <SectionHead marker="CAL.H1" label="BENCH CHECKLIST" />
      <p class="group-summary__lede">
        Cohorts are logged like calibration records. Each profile keeps its role, links, and working notes.
      </p>
      <div class="group-summary__chips">
        {chips.map((chip) => <span class="group-summary__chip hw-chip">{chip}</span>)}
      </div>
    </section>

    {cohorts.length === 0 ? (
      <div class="group-empty hw-empty">
        HARDWARE ROSTER EMPTY. Add cohorts and members to <code>src/data/members.json</code>.
      </div>
    ) : (
      cohorts.map((entry) => (
        <CohortSection cohort={entry.cohort} memberCount={entry.members.length}>
          <div class="hw-record-list">
            {entry.members.map((member, i) => {
              const focusLabel = member.focus || 'HARDWARE DEV';
              return (
                <article class="hw-record">
                  <div class="hw-record__index px">CH-{String(i + 1).padStart(2, '0')}</div>
                  <div class="hw-record__socket">
                    {member.avatar ? (
                      <img class="member-avatar" src={assetPath(member.avatar)} alt={`${member.name} avatar`} loading="lazy" />
                    ) : (
                      <div class="member-avatar-fallback hw-avatar-fb" aria-hidden="true">
                        {member.name.slice(0, 1)}
                      </div>
                    )}
                  </div>
                  <div class="hw-record__main">
                    <div class="hw-record__header">
                      <h3>{member.name}</h3>
                      <span>{focusLabel}</span>
                    </div>
                    <p class="hw-record__bio">{member.bio}</p>
                    <div class="member-role-tags">
                      {member.roleTags.map((tag, ti) => (
                        <span class="member-role-tag hw-tag">
                          <span class="hw-tag__ref">TP-{i + 1}{ti + 1}</span>
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                  {member.links && Object.values(member.links).some(Boolean) && (
                    <div class="member-links hw-record__links">
                      {member.links.github && <a href={member.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>}
                      {member.links.bilibili && <a href={member.links.bilibili} target="_blank" rel="noopener noreferrer">Bilibili</a>}
                      {member.links.blog && <a href={member.links.blog} target="_blank" rel="noopener noreferrer">Blog</a>}
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </CohortSection>
      ))
    )}
  </main>
</Base>

<style>
  .group-page--hardware {
    --hw-steel: #d8d3c7;
    --hw-paper: #e7e2d6;
    --hw-panel: #c8c2b6;
    --hw-ink: #181c1b;
    --hw-muted: #59645f;
    --hw-olive: #415247;
    --hw-copper: #9b6a2f;
    --hw-amber: #d1912c;
    --hw-scope: #39a86b;
    color: var(--hw-ink);
    padding-top: 76px;
  }

  .group-page--hardware::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -3;
    background:
      linear-gradient(90deg, rgba(24, 28, 27, 0.05) 1px, transparent 1px),
      linear-gradient(rgba(24, 28, 27, 0.04) 1px, transparent 1px),
      linear-gradient(180deg, #d8d3c7 0%, #e7e2d6 46%, #cfd6d0 100%);
    background-size: 52px 52px, 52px 52px, auto;
  }

  .group-page--hardware :global(.group-page-nav__home),
  .group-page--hardware :global(.group-page-nav__link) {
    color: var(--hw-ink);
    border: 1px solid rgba(24, 28, 27, 0.42);
    background: rgba(231, 226, 214, 0.9);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.45) inset;
  }

  .group-page--hardware :global(.group-page-nav__home:hover),
  .group-page--hardware :global(.group-page-nav__link:hover),
  .group-page--hardware :global(.group-page-nav__link.is-current) {
    border-color: var(--hw-olive);
    background: #c8c2b6;
  }

  .hw-fx {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .hw-fx__blueprint {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(90deg, transparent 0 86px, rgba(65, 82, 71, 0.08) 86px 88px),
      repeating-linear-gradient(0deg, transparent 0 86px, rgba(65, 82, 71, 0.06) 86px 88px);
    opacity: 0.7;
    mask-image: linear-gradient(180deg, #000, transparent 78%);
  }

  .hw-fx__trace {
    position: absolute;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(155, 106, 47, 0.62), transparent);
  }

  .hw-fx__trace--a { top: 210px; left: 4%; width: 34%; }
  .hw-fx__trace--b { top: 620px; right: 8%; width: 28%; }
  .hw-fx__trace--c { top: 1040px; left: 18%; width: 42%; }

  .hw-fx__mark {
    position: absolute;
    font-family: 'Press Start 2P', monospace;
    font-size: 7px;
    color: rgba(24, 28, 27, 0.34);
  }

  .hw-fx__mark--a { top: 270px; left: 11%; }
  .hw-fx__mark--b { top: 760px; right: 12%; }
  .hw-fx__mark--c { top: 1180px; left: 36%; }

  .hw-hero {
    margin: 0 auto;
  }

  .hw-hero__plate {
    position: relative;
    display: grid;
    grid-template-columns: minmax(280px, 0.9fr) minmax(360px, 1.1fr);
    gap: clamp(20px, 4vw, 48px);
    min-height: 430px;
    padding: clamp(22px, 4.2vw, 44px);
    border: 1px solid rgba(24, 28, 27, 0.7);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.32), transparent 32%),
      linear-gradient(180deg, #c8c2b6, #aeb6af);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      inset 0 -1px 0 rgba(24, 28, 27, 0.18),
      0 24px 48px rgba(24, 28, 27, 0.2);
  }

  .hw-hero__plate::before {
    content: 'OSC-CTRL / BOARD BRING-UP BENCH';
    position: absolute;
    top: 12px;
    left: 16px;
    font-family: 'Press Start 2P', monospace;
    font-size: 7px;
    color: rgba(24, 28, 27, 0.46);
  }

  .hw-hero__copy {
    align-self: end;
    max-width: 640px;
    padding-top: 56px;
  }

  .hw-hero__eyebrow {
    margin-bottom: 18px;
    color: var(--hw-olive);
    font-size: 9px;
  }

  .hw-hero__title {
    max-width: 620px;
    margin-bottom: 22px;
    color: var(--hw-ink);
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(26px, 5vw, 56px);
    line-height: 1.18;
    letter-spacing: 0;
  }

  .hw-hero__desc {
    max-width: 560px;
    color: #35413b;
    font-size: 22px;
    line-height: 1.42;
  }

  .hw-hero__readouts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 26px;
  }

  .hw-hero__readouts span {
    padding: 6px 9px;
    border: 1px solid rgba(24, 28, 27, 0.5);
    background: rgba(231, 226, 214, 0.7);
    font-family: 'Press Start 2P', monospace;
    font-size: 7px;
    color: #2f3c36;
  }

  .hw-instrument {
    position: relative;
    align-self: stretch;
    display: grid;
    grid-template-rows: 1fr auto auto;
    gap: 16px;
    min-width: 0;
    padding: 18px;
    border: 1px solid rgba(24, 28, 27, 0.72);
    background: linear-gradient(180deg, #252a28, #151817);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }

  .hw-instrument__scope {
    position: relative;
    min-height: 220px;
    overflow: hidden;
    border: 1px solid rgba(57, 168, 107, 0.32);
    background: #09110d;
  }

  .hw-instrument__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(57, 168, 107, 0.13) 1px, transparent 1px),
      linear-gradient(90deg, rgba(57, 168, 107, 0.13) 1px, transparent 1px);
    background-size: 36px 32px;
  }

  .hw-instrument__wave {
    position: absolute;
    inset: 18px;
    width: calc(100% - 36px);
    height: calc(100% - 36px);
  }

  .hw-instrument__wave path {
    fill: none;
    stroke: var(--hw-scope);
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 8px rgba(57, 168, 107, 0.55));
  }

  .hw-instrument__sweep {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(57, 168, 107, 0.45);
    box-shadow: 0 0 18px rgba(57, 168, 107, 0.4);
  }

  .hw-instrument__controls {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    align-items: center;
  }

  .hw-knob,
  .hw-port,
  .hw-led {
    display: block;
    justify-self: center;
  }

  .hw-knob {
    width: 50px;
    height: 50px;
    border: 1px solid #050706;
    border-radius: 50%;
    background:
      linear-gradient(90deg, transparent 47%, rgba(255, 255, 255, 0.25) 47% 53%, transparent 53%),
      radial-gradient(circle, #6b716b, #2c312f);
    box-shadow: inset 0 2px 2px rgba(255, 255, 255, 0.18), inset 0 -4px 8px rgba(0, 0, 0, 0.42);
  }

  .hw-knob--b {
    transform: rotate(42deg);
  }

  .hw-port {
    width: 42px;
    height: 42px;
    border: 6px solid #0b0d0c;
    border-radius: 50%;
    background: #c8c2b6;
  }

  .hw-led {
    width: 16px;
    height: 16px;
    border: 2px solid #050706;
    border-radius: 50%;
    background: var(--hw-amber);
    box-shadow: 0 0 16px rgba(209, 145, 44, 0.5);
  }

  .hw-fixture {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
    padding: 8px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(0, 0, 0, 0.18);
  }

  .hw-fixture span {
    height: 28px;
    border: 1px solid rgba(24, 28, 27, 0.85);
    background: var(--hw-copper);
  }

  .hw-summary {
    margin-top: 28px;
    border: 1px solid rgba(24, 28, 27, 0.62);
    border-radius: 0;
    background: rgba(231, 226, 214, 0.88);
    color: var(--hw-ink);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.48);
  }

  .hw-summary :global(.section-head) { color: var(--hw-ink); }
  .hw-summary :global(.section-head .marker) { background: var(--hw-ink); color: var(--hw-steel); border-color: var(--hw-ink); }
  .hw-summary :global(.section-head .line) { background: rgba(24, 28, 27, 0.62); }

  .hw-summary .group-summary__lede {
    color: var(--hw-muted);
  }

  .hw-chip {
    border: 1px solid rgba(24, 28, 27, 0.62);
    background: rgba(216, 211, 199, 0.72);
    color: var(--hw-ink);
  }

  .group-page--hardware :global(.cohort-section) {
    border: 1px solid rgba(24, 28, 27, 0.62);
    border-radius: 0;
    background: rgba(216, 211, 199, 0.68);
  }

  .group-page--hardware :global(.cohort-section__header) {
    border-bottom: 1px solid rgba(24, 28, 27, 0.62);
    background: rgba(200, 194, 182, 0.86);
    color: var(--hw-ink);
  }

  .group-page--hardware :global(.cohort-section__count) {
    color: var(--hw-muted);
  }

  .hw-record-list {
    display: grid;
    gap: 12px;
  }

  .hw-record {
    position: relative;
    display: grid;
    grid-template-columns: 64px 90px minmax(0, 1fr) auto;
    gap: 18px;
    align-items: start;
    padding: 16px;
    border: 1px solid rgba(24, 28, 27, 0.58);
    background:
      linear-gradient(90deg, rgba(65, 82, 71, 0.13), transparent 34%),
      rgba(231, 226, 214, 0.82);
    box-shadow: inset 4px 0 0 var(--hw-olive);
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .hw-record::after {
    content: '';
    position: absolute;
    right: 16px;
    top: 14px;
    width: 70px;
    height: 1px;
    background: rgba(155, 106, 47, 0.6);
  }

  .hw-record__index {
    color: var(--hw-copper);
    font-size: 7px;
    line-height: 1.7;
  }

  .hw-record__socket {
    position: relative;
    padding: 5px;
    border: 1px solid rgba(24, 28, 27, 0.72);
    background: #b8b2a7;
  }

  .hw-record__socket::before,
  .hw-record__socket::after {
    content: '';
    position: absolute;
    top: 10px;
    width: 4px;
    height: 8px;
    background: var(--hw-copper);
    box-shadow: 0 14px 0 var(--hw-copper), 0 28px 0 var(--hw-copper), 0 42px 0 var(--hw-copper);
  }

  .hw-record__socket::before { left: -6px; }
  .hw-record__socket::after { right: -6px; }

  .hw-record__socket .member-avatar,
  .hw-record__socket .member-avatar-fallback {
    width: 78px;
    height: 78px;
    border: 0;
    border-radius: 0;
  }

  .hw-avatar-fb {
    display: grid;
    place-items: center;
    background: #d8d3c7;
    color: var(--hw-olive);
    font-size: 22px;
  }

  .hw-record__main {
    min-width: 0;
  }

  .hw-record__header {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .hw-record__header h3 {
    color: var(--hw-ink);
    font-size: 28px;
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .hw-record__header span {
    font-family: 'Press Start 2P', monospace;
    font-size: 8px;
    color: var(--hw-olive);
    overflow-wrap: anywhere;
  }

  .hw-record__bio {
    color: #3d4843;
    font-size: 18px;
    line-height: 1.44;
  }

  .hw-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid rgba(24, 28, 27, 0.55);
    background: rgba(216, 211, 199, 0.72);
    color: var(--hw-ink);
  }

  .hw-tag__ref {
    font-family: 'Press Start 2P', monospace;
    font-size: 7px;
    color: var(--hw-copper);
  }

  .hw-record__links {
    align-self: center;
    justify-content: flex-end;
    margin-top: 0;
  }

  .group-page--hardware :global(.member-links a) {
    display: inline-block;
    padding: 5px 8px;
    border: 1px solid rgba(24, 28, 27, 0.62);
    background: rgba(200, 194, 182, 0.72);
    color: var(--hw-ink);
    font-family: 'Press Start 2P', monospace;
    font-size: 7px;
    line-height: 1.4;
  }

  .hw-empty {
    border: 1px dashed rgba(24, 28, 27, 0.62);
    background: rgba(231, 226, 214, 0.78);
    color: var(--hw-ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hw-instrument__sweep {
      animation: hw-sweep 3.8s linear infinite;
    }

    .hw-led {
      animation: hw-led 2.8s ease-in-out infinite;
    }

    .hw-record:hover {
      background-color: rgba(231, 226, 214, 0.96);
      border-color: rgba(24, 28, 27, 0.82);
    }
  }

  @keyframes hw-sweep {
    from { left: 0; }
    to { left: 100%; }
  }

  @keyframes hw-led {
    0%, 100% { opacity: 0.48; }
    50% { opacity: 1; }
  }

  @media (max-width: 840px) {
    .hw-hero__plate {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hw-instrument__scope {
      min-height: 180px;
    }

    .hw-record {
      grid-template-columns: 48px 86px minmax(0, 1fr);
    }

    .hw-record__links {
      grid-column: 3;
      justify-content: flex-start;
    }
  }

  @media (max-width: 640px) {
    .group-page--hardware {
      padding-top: 64px;
    }

    .hw-hero__plate {
      padding: 18px;
    }

    .hw-hero__title {
      font-size: 24px;
    }

    .hw-hero__desc {
      font-size: 18px;
    }

    .hw-record {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .hw-record__links {
      grid-column: auto;
    }

    .hw-record__socket {
      width: max-content;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hw-instrument__sweep,
    .hw-led,
    .hw-record {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
